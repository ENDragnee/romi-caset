---
// "Find us on" footer row, styled by .findus in global.css (matches the reference).
const SOCIAL = [
  { label: "vimeo", href: "https://vimeo.com/user262746173?fl=pp&fe=sh" },
  {
    label: "instagram",
    href: "https://www.instagram.com/biniromi.filmwork?vrfl=MXMyNmo1NTdlbTZmag%3D%3D&utm_source=qr",
  },
];
---

<div class="findus">
  <span class="lab">Find us on</span>
  {
    SOCIAL.map((s, i) => (
      <>
        {i > 0 && <i>/</i>}
        <a href={s.href} target="_blank" rel="noopener noreferrer">
          {s.label}
        </a>
      </>
    ))
  }
</div>
