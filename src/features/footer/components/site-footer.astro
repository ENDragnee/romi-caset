<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-find-us">
      <span class="find-us-label">FIND US ON</span>
      <a
        href="https://vimeo.com/user262746173?fl=pp&fe=sh"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
      >
        vimeo
      </a>
      <span class="separator">/</span>
      <a
        href="https://www.instagram.com/bini._romi?stkn=NWl6MmJ0MGt2MG9x&utm_source=qr"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
      >
        instagram
      </a>
      <span class="separator">/</span>
      <a
        href="https://youtube.com"
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
      >
        youtube
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding: var(--space-2xl) var(--space-xl);
    background-color: var(--color-bg);
    box-sizing: border-box;
  }

  .footer-container {
    width: 100%;
    max-width: var(--container-wide, 1400px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Bottom-Left Minimalist Link Bar (Reference Match) */
  .footer-find-us {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .find-us-label {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8c8c8c;
    margin-right: 2px;
  }

  .social-link {
    color: #000000;
    font-weight: 700;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .social-link:hover {
    opacity: 0.55;
  }

  .separator {
    color: #d0d0d0;
    font-weight: 400;
    font-size: 0.7rem;
    user-select: none;
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: var(--space-xl) var(--space-md);
    }

    .footer-find-us {
      gap: 6px;
      font-size: 0.725rem;
    }
  }
</style>
