---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

function formatEmbedUrl(rawUrl: string): string {
  if (!rawUrl) return "";

  if (rawUrl.includes("/embed/")) {
    return rawUrl;
  }

  const ytMatch = rawUrl.match(
    /(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:watch\?v=|shorts\/|live\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/,
  );
  if (ytMatch && ytMatch[1]) {
    return `https://www.youtube-nocookie.com/embed/${ytMatch[1]}?rel=0&modestbranding=1&playsinline=1`;
  }

  const vimeoMatch = rawUrl.match(
    /(?:https?:\/\/)?(?:www\.)?vimeo\.com\/(\d+)/,
  );
  if (vimeoMatch && vimeoMatch[1]) {
    return `https://player.vimeo.com/video/${vimeoMatch[1]}?dnt=1`;
  }

  return rawUrl;
}

const embedUrl = formatEmbedUrl(url);
---

<div class="video-container" data-video-embed>
  <div class="video-wrapper">
    {
      embedUrl ? (
        <iframe
          src={embedUrl}
          title={title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        />
      ) : (
        <div class="video-error">Invalid video URL</div>
      )
    }
  </div>
</div>

<style>
  .video-container {
    max-width: 960px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background-color: #000;
    cursor: auto !important;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
    cursor: auto !important;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    cursor: auto !important;
  }

  .video-error {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
