---
interface Props {
  url: string;
  title: string;
  thumbnail?: string | null;
}

const { url, title, thumbnail } = Astro.props;

// Extract Video Service & ID
function parseVideoSource(rawUrl: string): {
  type: "youtube" | "vimeo" | "direct" | "invalid";
  id: string;
} {
  if (!rawUrl) return { type: "invalid", id: "" };

  const ytMatch = rawUrl.match(
    /(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:watch\?v=|shorts\/|live\/|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/,
  );
  if (ytMatch && ytMatch[1]) {
    return { type: "youtube", id: ytMatch[1] };
  }

  const vimeoMatch = rawUrl.match(
    /(?:https?:\/\/)?(?:www\.)?(?:player\.)?vimeo\.com\/(?:video\/)?(\d+)/,
  );
  if (vimeoMatch && vimeoMatch[1]) {
    return { type: "vimeo", id: vimeoMatch[1] };
  }

  if (rawUrl.endsWith(".mp4") || rawUrl.endsWith(".webm")) {
    return { type: "direct", id: rawUrl };
  }

  return { type: "invalid", id: rawUrl };
}

const videoSource = parseVideoSource(url);
const posterSrc = thumbnail
  ? thumbnail.startsWith("http") || thumbnail.startsWith("/api/media/")
    ? thumbnail
    : `/api/media/${thumbnail.startsWith("/") ? thumbnail.slice(1) : thumbnail}`
  : videoSource.type === "youtube"
    ? `https://img.youtube.com/vi/${videoSource.id}/maxresdefault.jpg`
    : null;
---

<div
  class="custom-video-embed"
  data-video-type={videoSource.type}
  data-video-id={videoSource.id}
>
  <div class="video-stage">
    {/* Iframe Stage (Loaded on click or lazy) */}
    <div class="iframe-container" id="iframe-target"></div>

    {
      /* Poster Overlay with Centered Play Button & Bottom Title (Screenshot 2 Match) */
    }
    <div class="video-poster-overlay" id="video-poster-overlay">
      {posterSrc && <img src={posterSrc} alt={title} class="poster-image" />}

      {
        /* Minimalist White Play Triangle (Exact match to reference screenshot) */
      }
      <button
        type="button"
        class="center-play-btn"
        id="video-play-btn"
        aria-label="Play video"
      >
        <svg width="40" height="40" viewBox="0 0 24 24" fill="white">
          <polygon points="6 3 20 12 6 21 6 3"></polygon>
        </svg>
      </button>

      {/* Bottom Left Lowercase Editorial Title */}
      <div class="bottom-title-caption font-editorial">
        <span>{title.toLowerCase()}</span>
      </div>
    </div>
  </div>
</div>

<script>
  function InitCustomVideoPlayer() {
    const containers = document.querySelectorAll<HTMLElement>(
      ".custom-video-embed",
    );

    containers.forEach((container) => {
      const type = container.dataset.videoType;
      const id = container.dataset.videoId;
      const overlay = container.querySelector<HTMLElement>(
        "#video-poster-overlay",
      );
      const playBtn =
        container.querySelector<HTMLButtonElement>("#video-play-btn");
      const iframeTarget =
        container.querySelector<HTMLElement>("#iframe-target");

      if (!type || !id || !overlay || !playBtn || !iframeTarget) return;

      playBtn.onclick = () => {
        overlay.classList.add("hidden");

        if (type === "youtube") {
          // Chromeless YouTube Embed with parameters
          iframeTarget.innerHTML = `
            <iframe
              src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&controls=1"
              title="Video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          `;
        } else if (type === "vimeo") {
          // Chromeless Vimeo Embed
          iframeTarget.innerHTML = `
            <iframe
              src="https://player.vimeo.com/video/${id}?autoplay=1&dnt=1&title=0&byline=0&portrait=0"
              title="Video player"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          `;
        } else if (type === "direct") {
          iframeTarget.innerHTML = `
            <video src="${id}" controls autoplay playsinline class="direct-video"></video>
          `;
        }
      };
    });
  }

  InitCustomVideoPlayer();
  document.addEventListener("astro:page-load", InitCustomVideoPlayer);
</script>

<style>
  .custom-video-embed {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    position: relative;
    background-color: #000000;
    box-shadow: var(--shadow-lg);
  }

  .video-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #000000;
  }

  .iframe-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  :global(.iframe-container iframe),
  :global(.iframe-container video) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  /* Overlay Stage */
  .video-poster-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.4s ease;
  }

  .video-poster-overlay.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .poster-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.92);
  }

  /* Minimalist Centered White Play Triangle (Screenshot 2 Match) */
  .center-play-btn {
    position: relative;
    z-index: 3;
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }

  .center-play-btn svg {
    filter: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.6));
    transition: transform 0.2s ease;
  }

  .video-poster-overlay:hover .center-play-btn svg {
    transform: scale(1.15);
  }

  /* Bottom Left Editorial Title Caption (Screenshot 2 Match) */
  .bottom-title-caption {
    position: absolute;
    bottom: var(--space-lg);
    left: var(--space-xl);
    z-index: 3;
    color: #ffffff;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
    user-select: none;
  }

  @media (max-width: 768px) {
    .video-stage {
      aspect-ratio: 16 / 10;
    }
    .bottom-title-caption {
      bottom: var(--space-md);
      left: var(--space-md);
      font-size: 1.1rem;
    }
    .center-play-btn svg {
      width: 32px;
      height: 32px;
    }
  }
</style>
