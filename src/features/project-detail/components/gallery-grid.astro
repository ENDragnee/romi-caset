---
interface Props {
  images: string[];
  alt: string;
}

const { images = [], alt = "Behind the scenes" } = Astro.props;

function getMediaUrl(src: string | null | undefined): string {
  if (!src) return "";
  if (
    src.startsWith("http://") ||
    src.startsWith("https://") ||
    src.startsWith("/api/media/")
  ) {
    return src;
  }
  return `/api/media/${src.startsWith("/") ? src.slice(1) : src}`;
}
---

<div class="gallery-wrapper">
  <div class="gallery-grid">
    {
      images.map((imgKey, i) => {
        const src = getMediaUrl(imgKey);
        if (!src) return null;

        return (
          <div class={`gallery-item animate-in stagger-${(i % 9) + 1}`}>
            <img
              src={src}
              alt={`${alt} — Still ${i + 1}`}
              loading="lazy"
              decoding="async"
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .gallery-wrapper {
    width: 100%;
    max-width: 920px; /* Aligns with the video container above */
    margin: 0 auto;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 columns across */
    gap: 8px; /* Tight film-still gap matching the reference */
    width: 100%;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10; /* Clean film-still aspect ratio */
    background-color: var(--color-surface);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform 0.4s ease,
      filter 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.03);
    filter: brightness(1.05);
  }

  /* 2 columns on mobile/tablet */
  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }
  }
</style>
