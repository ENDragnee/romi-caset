---
import type { Project } from "../../../lib/types";
import ProjectCard from "./project-card.astro";
import ProjectCardWide from "./project-card-wide.astro";

interface Props {
  projects: Project[];
}

const { projects = [] } = Astro.props;
---

<div class="portfolio-grid-container">
  <div class="project-grid">
    {
      projects.map((project, index) => (
        <div class="grid-item" data-category={project.category}>
          {project.cardType === "WIDE" ? (
            <ProjectCardWide project={project} index={index} />
          ) : (
            <ProjectCard project={project} index={index} />
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .portfolio-grid-container {
    width: 100%;
    max-width: 1380px; /* Expansive wide studio canvas */
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 columns on desktop */
    gap: var(--space-xl) var(--space-lg);
    width: 100%;
    align-items: start;
  }

  .grid-item {
    width: 100%;
    grid-column: span 1 !important;
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.4s ease,
      transform 0.4s ease;
    will-change: opacity, filter, transform;
  }

  :global(.grid-item.is-dimmed) {
    opacity: 0.18 !important;
    filter: grayscale(100%) brightness(0.4) !important;
    pointer-events: none !important;
    transform: scale(0.98);
  }

  /* Medium Tablets: 2 columns */
  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  /* Mobile: Single 1-column stack (Matches Pulse Films mobile screenshot) */
  @media (max-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
