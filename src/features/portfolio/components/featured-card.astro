---
// src/features/portfolio/components/featured-card.astro

interface Props {
  id: string;
  client: string;
  title: string;
  category: string;
  thumbnail?: string | null;
  priority?: boolean;
}

const {
  id,
  client,
  title,
  category,
  thumbnail = null,
  priority = false,
} = Astro.props;

// Resolve S3 key / media path into a streamable API URL
function getMediaUrl(src: string | null | undefined): string {
  if (!src) return "";
  if (
    src.startsWith("http://") ||
    src.startsWith("https://") ||
    src.startsWith("/api/media/") ||
    src.startsWith("data:")
  ) {
    return src;
  }
  if (src.startsWith("/images/") || src.startsWith("/branding/")) {
    return src;
  }
  return `/api/media/${src.startsWith("/") ? src.slice(1) : src}`;
}

const resolvedThumbnail = getMediaUrl(thumbnail);
---

<a
  class="proj rise"
  href={`/project/${id}`}
  data-id={id}
  data-cat={category.toLowerCase()}
>
  <div class="thumb">
    <div class="in">
      {
        resolvedThumbnail ? (
          <img
            src={resolvedThumbnail}
            alt={`${client} – ${title}`}
            loading={priority ? "eager" : "lazy"}
            decoding="async"
            draggable="false"
          />
        ) : (
          <div class="placeholder-box">
            <span class="placeholder-text">{client}</span>
          </div>
        )
      }
    </div>
  </div>
  <div class="cap">
    <span class="cl">{client}</span>
    <span class="separator">|</span>
    <span class="t">'{title.toUpperCase()}'</span>
  </div>
</a>

<style>
  .proj {
    display: block;
    text-decoration: none;
    color: inherit;
    transition:
      opacity 0.75s cubic-bezier(0.4, 0, 0.2, 1),
      filter 0.75s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-text) 9%, var(--color-bg));
  }

  .thumb .in {
    position: absolute;
    inset: 0;
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
    translate: var(--wx, 0px) var(--wv, 0px);
  }

  .proj:hover .thumb .in {
    transform: scale(1.035);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: blur(var(--sb, 0px));
  }

  .placeholder-box {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
  }

  .placeholder-text {
    font-family: var(--mf);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    opacity: 0.35;
    text-transform: uppercase;
  }

  .cap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    text-align: center;
    font-family: var(--mf);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    height: 3.4rem;
    padding: 0 0.5rem;
  }

  .cap .cl {
    font-weight: 700;
  }

  .cap .separator {
    opacity: 0.35;
  }

  .cap .t {
    opacity: 0.55;
    transition: opacity 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .proj:hover .cap .t {
    opacity: 1;
  }

  .proj.dim,
  .proj.dim.rise.in {
    opacity: 0.13;
    filter: grayscale(1);
  }

  .rise {
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .rise.in {
    opacity: 1;
    transform: none;
  }

  .proj.rise.fb {
    opacity: 1;
    transform: translateY(112vh);
  }

  .proj.rise.fb.in {
    transform: none;
    transition: transform 0.62s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proj.rise.fb .cap {
    opacity: 0;
  }

  .proj.rise.fb.in .cap {
    opacity: 1;
    transition: opacity 0.4s ease 0.42s;
  }
</style>
