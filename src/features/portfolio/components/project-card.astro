---
import type { Project } from "../../../lib/types";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const staggerClass = `stagger-${(index % 9) + 1}`;

function getMediaUrl(src: string | null | undefined): string {
  if (!src) return "";
  if (
    src.startsWith("http://") ||
    src.startsWith("https://") ||
    src.startsWith("/api/media/")
  ) {
    return src;
  }
  return `/api/media/${src.startsWith("/") ? src.slice(1) : src}`;
}

const imageSrc = getMediaUrl(project.thumbnail);
---

<a
  href={`/project/${project.slug}`}
  class={`project-card-wrapper animate-in ${staggerClass}`}
>
  <div class="image-stage">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={project.title}
          class="project-img"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-placeholder" />
      )
    }
  </div>

  <div class="project-bottom-meta">
    <div class="title-row">
      <h3 class="project-title">{project.title}</h3>
      {project.client && <span class="project-client">{project.client}</span>}
    </div>
    <div class="sub-row">
      <span class="project-category">{project.category}</span>
      {project.year && <span class="project-year">{project.year}</span>}
    </div>
  </div>
</a>

<style>
  .project-card-wrapper {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    width: 100%;
    color: inherit;
    transition: transform var(--transition-normal);
  }

  .image-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--color-surface);
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface);
  }

  .project-card-wrapper:hover .project-img {
    transform: scale(1.03);
  }

  .project-bottom-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
  }

  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }

  .project-client {
    font-family: var(--font-heading);
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sub-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.725rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
