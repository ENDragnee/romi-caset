---
import type { Project } from "../../../lib/types";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const staggerClass = `stagger-${(index % 9) + 1}`;

function getMediaUrl(src: string | null | undefined): string {
  if (!src) return "";
  if (
    src.startsWith("http://") ||
    src.startsWith("https://") ||
    src.startsWith("/api/media/")
  ) {
    return src;
  }
  return `/api/media/${src.startsWith("/") ? src.slice(1) : src}`;
}

const imageSrc = getMediaUrl(project.thumbnail);

// Format single-line title: CLIENT | 'TITLE' (Reference Match)
const formattedTitle = project.client
  ? `${project.client.toUpperCase()} | '${project.title.toUpperCase()}'`
  : `'${project.title.toUpperCase()}'`;
---

<a
  href={`/project/${project.slug}`}
  class={`project-card-wrapper animate-in ${staggerClass}`}
>
  <div class="image-stage">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={project.title}
          class="project-img"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-placeholder" />
      )
    }
  </div>

  {/* Single Line Caption matching Reference */}
  <div class="project-bottom-caption">
    <span class="caption-text">{formattedTitle}</span>
  </div>
</a>

<style>
  .project-card-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    width: 100%;
    color: inherit;
  }

  .image-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface);
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface);
  }

  .project-card-wrapper:hover .project-img {
    transform: scale(1.03);
  }

  /* Single-Line Caption below card */
  .project-bottom-caption {
    width: 100%;
    padding-top: 2px;
  }

  .caption-text {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 1.4;
    display: block;
    word-break: break-word;
    transition: opacity var(--transition-fast);
  }

  .project-card-wrapper:hover .caption-text {
    opacity: 0.65;
  }

  @media (max-width: 768px) {
    .caption-text {
      font-size: 0.775rem;
      letter-spacing: 0.08em;
    }
  }
</style>
