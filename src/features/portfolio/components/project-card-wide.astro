---
import type { Project } from "../../../lib/types";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const staggerClass = `stagger-${(index % 9) + 1}`;

function getMediaUrl(src: string | null | undefined): string {
  if (!src) return "";
  if (
    src.startsWith("http://") ||
    src.startsWith("https://") ||
    src.startsWith("/api/media/")
  ) {
    return src;
  }
  return `/api/media/${src.startsWith("/") ? src.slice(1) : src}`;
}

const imageSrc = getMediaUrl(project.thumbnail);
const clientPrefix = project.client ? `${project.client.toUpperCase()} | ` : "";
---

<a
  href={`/project/${project.slug}`}
  class={`project-card-wide animate-in ${staggerClass}`}
>
  <div class="card-inner">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={project.title}
          class="project-img"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-placeholder" />
      )
    }

    {/* Centered Hover Overlay: CLIENT | 'TITLE' / CATEGORY - YEAR */}
    <div class="card-overlay">
      <div class="overlay-content">
        <h3 class="project-title">
          {clientPrefix}'{project.title.toUpperCase()}'
        </h3>
        <span class="project-subtext"
          >{project.category}{project.year ? ` - ${project.year}` : ""}</span
        >
      </div>
    </div>
  </div>
</a>

<style>
  .project-card-wide {
    display: block;
    text-decoration: none;
    overflow: hidden;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-surface);
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-surface);
  }

  /* Centered Overlay matching shotbypersona.com */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-md);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .project-title {
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.35;
  }

  .project-subtext {
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .project-card-wide:hover .project-img {
    transform: scale(1.03);
  }

  .project-card-wide:hover .card-overlay {
    opacity: 1;
  }
</style>
