---
import type { Project } from "../../../lib/types";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const staggerClass = `stagger-${(index % 9) + 1}`;

function getMediaUrl(src: string | null | undefined): string {
  if (!src) return "";
  if (
    src.startsWith("http://") ||
    src.startsWith("https://") ||
    src.startsWith("/api/media/")
  ) {
    return src;
  }
  return `/api/media/${src.startsWith("/") ? src.slice(1) : src}`;
}

const imageSrc = getMediaUrl(project.thumbnail);
---

<a
  href={`/project/${project.slug}`}
  class={`project-card-wide animate-in ${staggerClass}`}
>
  <div class="card-inner">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={project.title}
          class="project-img"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-placeholder">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <polyline points="21 15 16 10 5 21" />
          </svg>
        </div>
      )
    }
    <div class="card-overlay">
      <h3 class="project-title">{project.title}</h3>
      {project.client && <p class="project-client">{project.client}</p>}
    </div>
  </div>
</a>

<style>
  .project-card-wide {
    display: block;
    text-decoration: none;
    overflow: hidden;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-surface);
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--color-surface),
      var(--color-surface-elevated)
    );
    color: var(--color-text-muted);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.75rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-title {
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .project-client {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.75rem;
    margin: 2px 0 0 0;
  }

  .project-card-wide:hover .project-img {
    transform: scale(1.03);
  }

  .project-card-wide:hover .card-overlay {
    opacity: 1;
  }
</style>
