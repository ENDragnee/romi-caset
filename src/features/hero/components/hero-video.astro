---
interface Props {
  videos?: string[];
}

const { videos = ["/videos/hero-video.mp4"] } = Astro.props;

// Ensure local fallback is prioritized if videos are empty or pending
const fallbackVideo = "/videos/hero-video.mp4";
const initialVideo = videos.length > 0 && videos[0] ? videos[0] : fallbackVideo;
const initialVideosJson = JSON.stringify(
  videos.length > 0 ? videos : [fallbackVideo],
);
const hasMultiple = videos.length > 1;
---

<section
  class="hero-stage"
  id="hero-section"
  data-videos={initialVideosJson}
  data-fallback={fallbackVideo}
>
  <div class="video-container">
    <video
      id="hero-video-a"
      class="hero-video active"
      autoplay
      muted
      loop={!hasMultiple}
      playsinline
      preload="auto"
      src={fallbackVideo}
      data-target-src={initialVideo}></video>

    {
      hasMultiple && (
        <video
          id="hero-video-b"
          class="hero-video inactive"
          muted
          playsinline
          preload="none"
        />
      )
    }
  </div>

  <div class="hero-film-grain" aria-hidden="true"></div>

  <button
    id="scroll-to-featured-btn"
    class="featured-scroll-cue"
    type="button"
    aria-label="Scroll to featured work"
  >
    <span class="cue-label">FEATURED</span>
    <svg
      class="cue-chevron"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
    >
      <path d="M1 4.5L6 9.5L11 4.5"></path>
    </svg>
  </button>
</section>

<script>
  function InitHero() {
    const videoA = document.querySelector<HTMLVideoElement>("#hero-video-a");
    const heroSection = document.querySelector<HTMLElement>("#hero-section");
    const scrollBtn = document.querySelector<HTMLButtonElement>(
      "#scroll-to-featured-btn",
    );

    if (videoA && heroSection) {
      const targetSrc = videoA.dataset.targetSrc;
      const fallback = heroSection.dataset.fallback || "/videos/hero-video.mp4";

      // If backend provides a specific remote URL, verify readiness before hot-swapping
      if (targetSrc && targetSrc !== fallback) {
        const testVid = document.createElement("video");
        testVid.src = targetSrc;
        testVid.preload = "auto";
        testVid.oncanplay = () => {
          videoA.src = targetSrc;
          videoA.play().catch(() => {});
        };
      }
    }

    if (scrollBtn) {
      scrollBtn.onclick = () => {
        const target = document.querySelector("#featured-section");
        if (target) {
          target.scrollIntoView({ behavior: "smooth" });
        }
      };
    }
  }

  InitHero();
  document.addEventListener("astro:page-load", InitHero);
</script>

<style>
  .hero-stage {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .video-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-video.active {
    opacity: 1;
  }

  .hero-video.inactive {
    opacity: 0;
  }

  .hero-film-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }

  .featured-scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mf);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: opacity 0.3s;
  }

  .featured-scroll-cue:hover {
    opacity: 0.55;
  }

  .cue-chevron {
    animation: chevronBob 2s infinite ease-in-out;
  }

  @keyframes chevronBob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
</style>
