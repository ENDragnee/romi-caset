---

---

<section class="hero-section" id="hero-section">
  {/* Background Video (Fades in smoothly once buffered) */}
  <video
    id="hero-video"
    class="hero-video"
    src="/videos/hero-video.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="auto"></video>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    {/* Central Brand Logo (Triggered only after video loads) */}
    <div class="hero-brand-drop">
      <img src="/images/logo.png" alt="KASET PRODUCTION" class="hero-logo" />
    </div>

    {/* Tagline */}
    <h1 class="hero-tagline">Music Video &middot; Commercial &middot; Film</h1>
  </div>

  <div class="scroll-indicator">
    <div class="mouse">
      <div class="wheel"></div>
    </div>
  </div>
</section>

<script>
  function InitHeroVideo() {
    const heroSection = document.querySelector<HTMLElement>("#hero-section");
    const video = document.querySelector<HTMLVideoElement>("#hero-video");
    if (!heroSection || !video) return;

    let isTriggered = false;

    const startHeroAnimations = () => {
      if (isTriggered) return;
      isTriggered = true;
      heroSection.classList.add("is-ready");
    };

    // If already loaded / cached in memory
    if (video.readyState >= 3) {
      startHeroAnimations();
    } else {
      video.addEventListener("canplay", startHeroAnimations, { once: true });
      video.addEventListener("playing", startHeroAnimations, { once: true });
      video.addEventListener("loadeddata", startHeroAnimations, { once: true });

      // Safety fallback (e.g. low-power mode on mobile where video autoplay is restricted)
      setTimeout(startHeroAnimations, 1200);
    }
  }

  InitHeroVideo();
  document.addEventListener("astro:page-load", InitHeroVideo);
</script>

<style>
  .hero-section {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    padding-top: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  /* Smoothly reveal video once loaded */
  .hero-section.is-ready .hero-video {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25) 0%,
      rgba(0, 0, 0, 0.8) 100%
    );
    z-index: -1;
  }

  .hero-content {
    text-align: center;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Keyframes: Top-to-Bottom Entrance */
  @keyframes logoDropIn {
    0% {
      opacity: 0;
      transform: translateY(-90px) scale(0.92);
      filter: blur(8px);
    }
    60% {
      opacity: 1;
      filter: blur(0px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes taglineFadeIn {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Initial state: Hidden */
  .hero-brand-drop {
    opacity: 0;
    will-change: transform, opacity;
  }

  .hero-tagline {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    opacity: 0;
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-2xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    opacity: 0;
  }

  /* Triggered only after video is ready */
  .hero-section.is-ready .hero-brand-drop {
    animation: logoDropIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }

  .hero-section.is-ready .hero-tagline {
    animation: taglineFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
  }

  .hero-section.is-ready .scroll-indicator {
    animation: taglineFadeIn 0.8s ease 0.6s forwards;
  }

  .hero-logo {
    width: 260px;
    max-width: 80%;
    margin-bottom: var(--space-md);
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.5));
  }

  .mouse {
    width: 24px;
    height: 36px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-full);
    position: relative;
  }

  .wheel {
    width: 4px;
    height: 8px;
    background-color: white;
    border-radius: var(--radius-full);
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    animation: scroll 2s infinite;
  }

  @keyframes scroll {
    0% {
      transform: translate(-50%, 0);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, 12px);
      opacity: 0;
    }
  }
</style>
