---
interface Props {
  videos?: string[];
}

const { videos = ["/videos/hero-video.mp4"] } = Astro.props;

const initialVideosJson = JSON.stringify(videos);
const hasMultiple = videos.length > 1;
---

<section class="hero-section" id="hero-section" data-videos={initialVideosJson}>
  {/* Dual video elements for seamless zero-flicker cross-fades */}
  <div class="video-crossfade-stage">
    <video
      id="hero-video-a"
      class="hero-video active"
      src={videos[0]}
      autoplay
      muted
      playsinline
      preload="auto"
      disablepictureinpicture
      disableRemotePlayback></video>

    {
      hasMultiple && (
        <video
          id="hero-video-b"
          class="hero-video inactive"
          src={videos[1] || videos[0]}
          muted
          playsinline
          preload="auto"
          disablepictureinpicture
          disableRemotePlayback
        />
      )
    }
  </div>

  {/* Clean, subtle uniform overlay — NO bottom fade to black */}
  <div class="hero-overlay"></div>

  {
    hasMultiple && (
      <div id="video-carousel-indicator" class="video-carousel-indicator">
        <span id="current-clip-index" class="clip-counter">
          01
        </span>
        <span class="clip-divider">/</span>
        <span class="clip-total">{String(videos.length).padStart(2, "0")}</span>
      </div>
    )
  }

  {/* Centered FEATURED ∨ scroll cue */}
  <button
    id="scroll-to-featured-btn"
    class="featured-scroll-cue"
    type="button"
    aria-label="Scroll to featured work"
  >
    <span class="cue-label">FEATURED</span>
    <svg
      class="cue-chevron"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
</section>

<script>
  function InitHeroVideoCarousel() {
    const heroSection = document.querySelector<HTMLElement>("#hero-section");
    const videoA = document.querySelector<HTMLVideoElement>("#hero-video-a");
    const videoB = document.querySelector<HTMLVideoElement>("#hero-video-b");
    const indicatorEl = document.querySelector<HTMLElement>(
      "#current-clip-index",
    );
    const scrollBtn = document.querySelector<HTMLButtonElement>(
      "#scroll-to-featured-btn",
    );

    if (!heroSection || !videoA) return;

    let videoList: string[] = [];
    try {
      videoList = JSON.parse(
        heroSection.dataset.videos || '["/videos/hero-video.mp4"]',
      );
    } catch {
      videoList = ["/videos/hero-video.mp4"];
    }

    let currentIndex = 0;
    let isVideoReady = false;

    const renderHero = () => {
      if (isVideoReady) return;
      isVideoReady = true;
      heroSection.classList.add("is-ready");
    };

    videoA.muted = true;
    videoA.defaultMuted = true;
    if (videoB) {
      videoB.muted = true;
      videoB.defaultMuted = true;
    }

    // Initial readiness trigger
    if (videoA.readyState >= 2 && !videoA.paused) {
      renderHero();
    } else {
      videoA.addEventListener("loadeddata", renderHero, { once: true });
      videoA.addEventListener("playing", renderHero, { once: true });
      videoA.addEventListener("canplay", renderHero, { once: true });
      videoA.play().catch(() => renderHero());
      setTimeout(renderHero, 600);
    }

    // Sequential multi-video carousel logic
    if (videoList.length > 1 && videoB) {
      let activeVideo = videoA;
      let standbyVideo = videoB;

      const playNextVideo = () => {
        const nextIndex = (currentIndex + 1) % videoList.length;
        currentIndex = nextIndex;

        // Prepare standby video with the next source
        standbyVideo.src = videoList[nextIndex];
        standbyVideo.currentTime = 0;

        standbyVideo
          .play()
          .then(() => {
            // Cross-fade: Bring standby to front, fade active to back
            standbyVideo.classList.remove("inactive");
            standbyVideo.classList.add("active");
            activeVideo.classList.remove("active");
            activeVideo.classList.add("inactive");

            // Update counter (e.g. "02")
            if (indicatorEl) {
              indicatorEl.textContent = String(nextIndex + 1).padStart(2, "0");
            }

            // Swap references
            const temp = activeVideo;
            activeVideo = standbyVideo;
            standbyVideo = temp;

            // Attach listener for the new active video
            activeVideo.addEventListener("ended", playNextVideo, {
              once: true,
            });
          })
          .catch((err) => {
            console.error("Video crossfade error:", err);
            setTimeout(playNextVideo, 2000);
          });
      };

      activeVideo.addEventListener("ended", playNextVideo, { once: true });
    } else {
      // Single video: standard seamless loop
      videoA.loop = true;
    }

    // Smooth scroll down when cue clicked
    if (scrollBtn) {
      scrollBtn.onclick = (e) => {
        e.preventDefault();
        const target = document.querySelector("#featured-section");
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      };
    }
  }

  InitHeroVideoCarousel();
  document.addEventListener("astro:page-load", InitHeroVideoCarousel);
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
  }

  .video-crossfade-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: translateZ(0);
    will-change: opacity;
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-video.active {
    opacity: 1;
    z-index: 1;
  }

  .hero-video.inactive {
    opacity: 0;
    z-index: 0;
  }

  /* Clean subtle uniform film overlay without bottom fade */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.22);
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding-inline: var(--space-md);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  @keyframes logoDropIn {
    0% {
      opacity: 0;
      transform: translateY(-70px) scale(0.94);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
  }

  @keyframes taglineFadeIn {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-brand-drop {
    opacity: 0;
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--space-md);
    will-change: transform, opacity;
  }

  .hero-logo {
    width: clamp(180px, 45vw, 260px);
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.6));
  }

  .hero-tagline {
    font-family: var(--font-heading);
    font-size: clamp(0.68rem, 2.2vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.25em;
    text-indent: 0.25em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    padding: 0;
    width: 100%;
    text-align: center;
    opacity: 0;
    line-height: 1.5;
  }

  /* Multi-video carousel index badge */
  .video-carousel-indicator {
    position: absolute;
    bottom: var(--space-xl);
    right: var(--space-2xl);
    z-index: 3;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.8);
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.4);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .clip-divider {
    opacity: 0.4;
  }

  /* Centered FEATURED ∨ cue */
  .featured-scroll-cue {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.85);
    padding: var(--space-2xs) var(--space-md);
    opacity: 0;
    transition:
      opacity 0.5s ease,
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .featured-scroll-cue:hover {
    color: var(--color-accent);
    transform: translateX(-50%) translateY(2px);
  }

  .cue-label {
    font-family: var(--font-heading);
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-indent: 0.25em;
    text-transform: uppercase;
  }

  @keyframes cuePulseBounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.75;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }

  .cue-chevron {
    animation: cuePulseBounce 2s infinite ease-in-out;
  }

  .hero-section.is-ready .hero-brand-drop {
    animation: logoDropIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }

  .hero-section.is-ready .hero-tagline {
    animation: taglineFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  .hero-section.is-ready .featured-scroll-cue {
    opacity: 1;
    transition-delay: 0.4s;
  }

  @media (max-width: 768px) {
    .hero-tagline {
      letter-spacing: 0.18em;
      text-indent: 0.18em;
    }

    .featured-scroll-cue {
      bottom: var(--space-lg);
    }

    .video-carousel-indicator {
      bottom: var(--space-lg);
      right: var(--space-lg);
    }
  }
</style>
