---

---

<section class="hero-section" id="hero-section">
  {/* Background Video */}
  <video
    id="hero-video"
    class="hero-video"
    src="/videos/hero-video.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    disableRemotePlayback></video>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    {/* Central Brand Logo (Drops in once video renders) */}
    <div class="hero-brand-drop">
      <img src="/images/logo.png" alt="KASET PRODUCTION" class="hero-logo" />
    </div>

    {/* Centered Tagline */}
    <h1 class="hero-tagline">
      <span>Music Video &middot; Commercial &middot; Film</span>
    </h1>
  </div>

  <div class="scroll-indicator">
    <div class="mouse">
      <div class="wheel"></div>
    </div>
  </div>
</section>

<script>
  function InitHeroVideo() {
    const heroSection = document.querySelector<HTMLElement>("#hero-section");
    const video = document.querySelector<HTMLVideoElement>("#hero-video");
    if (!heroSection || !video) return;

    let isTriggered = false;

    const renderHero = () => {
      if (isTriggered) return;
      isTriggered = true;
      heroSection.classList.add("is-ready");
    };

    video.muted = true;
    video.defaultMuted = true;

    if (video.readyState >= 2 && !video.paused) {
      renderHero();
    } else {
      video.addEventListener("loadeddata", renderHero, { once: true });
      video.addEventListener("playing", renderHero, { once: true });
      video.addEventListener("canplay", renderHero, { once: true });

      video.play().catch(() => {
        renderHero();
      });

      setTimeout(renderHero, 600);
    }
  }

  InitHeroVideo();
  document.addEventListener("astro:page-load", InitHeroVideo);
</script>

<style>
  .hero-section {
    position: relative;
    /* Responsive viewport height covering mobile dynamic address bars */
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    height: 100dvh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
    box-sizing: border-box;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0;
    transform: translateZ(0);
    will-change: opacity;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Fade video in smoothly once ready */
  .hero-section.is-ready .hero-video {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25) 0%,
      rgba(0, 0, 0, 0.75) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding-inline: var(--space-md);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* Keyframe Animations */
  @keyframes logoDropIn {
    0% {
      opacity: 0;
      transform: translateY(-70px) scale(0.94);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
  }

  @keyframes taglineFadeIn {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-brand-drop {
    opacity: 0;
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--space-md);
    will-change: transform, opacity;
  }

  .hero-logo {
    width: clamp(180px, 45vw, 260px);
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.6));
  }

  /* Perfectly Centered Tagline on Mobile & Desktop */
  .hero-tagline {
    font-family: var(--font-heading);
    font-size: clamp(0.68rem, 2.2vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.25em;
    text-indent: 0.25em; /* Counterbalance trailing letter-spacing */
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    padding: 0;
    width: 100%;
    text-align: center;
    opacity: 0;
    line-height: 1.5;
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    opacity: 0;
  }

  /* Triggered together once video is ready */
  .hero-section.is-ready .hero-brand-drop {
    animation: logoDropIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }

  .hero-section.is-ready .hero-tagline {
    animation: taglineFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  .hero-section.is-ready .scroll-indicator {
    animation: taglineFadeIn 0.7s ease 0.5s forwards;
  }

  .mouse {
    width: 22px;
    height: 34px;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-full);
    position: relative;
  }

  .wheel {
    width: 3px;
    height: 7px;
    background-color: white;
    border-radius: var(--radius-full);
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    animation: scroll 2s infinite;
  }

  @keyframes scroll {
    0% {
      transform: translate(-50%, 0);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, 10px);
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-tagline {
      letter-spacing: 0.18em;
      text-indent: 0.18em;
    }
  }
</style>
