---

---

<section class="hero-section" id="hero-section">
  {/* Full-bleed background video */}
  <video
    id="hero-video"
    class="hero-video"
    src="/videos/hero-video.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    disableRemotePlayback></video>
  <div class="hero-overlay"></div>

  {/* Centered FEATURED ∨ cue */}
  <button
    id="scroll-to-featured-btn"
    class="featured-scroll-cue"
    type="button"
    aria-label="Scroll to featured work"
  >
    <span class="cue-label">FEATURED</span>
    <svg
      class="cue-chevron"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
</section>

<script>
  function InitHeroVideo() {
    const heroSection = document.querySelector<HTMLElement>("#hero-section");
    const video = document.querySelector<HTMLVideoElement>("#hero-video");
    const scrollBtn = document.querySelector<HTMLButtonElement>(
      "#scroll-to-featured-btn",
    );
    if (!heroSection || !video) return;

    let isTriggered = false;

    const renderHero = () => {
      if (isTriggered) return;
      isTriggered = true;
      heroSection.classList.add("is-ready");
    };

    video.muted = true;
    video.defaultMuted = true;

    if (video.readyState >= 2 && !video.paused) {
      renderHero();
    } else {
      video.addEventListener("loadeddata", renderHero, { once: true });
      video.addEventListener("playing", renderHero, { once: true });
      video.addEventListener("canplay", renderHero, { once: true });

      video.play().catch(() => {
        renderHero();
      });

      setTimeout(renderHero, 600);
    }

    if (scrollBtn) {
      scrollBtn.onclick = (e) => {
        e.preventDefault();
        const target = document.querySelector("#featured-section");
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      };
    }
  }

  InitHeroVideo();
  document.addEventListener("astro:page-load", InitHeroVideo);
</script>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateZ(0);
    will-change: opacity;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-section.is-ready .hero-video {
    opacity: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25) 0%,
      rgba(0, 0, 0, 0.4) 60%,
      rgba(0, 0, 0, 0.8) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding-inline: var(--space-md);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
  }

  @keyframes logoDropIn {
    0% {
      opacity: 0;
      transform: translateY(-70px) scale(0.94);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }
  }

  @keyframes taglineFadeIn {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-brand-drop {
    opacity: 0;
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--space-md);
    will-change: transform, opacity;
  }

  .hero-logo {
    width: clamp(180px, 45vw, 260px);
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.6));
  }

  .hero-tagline {
    font-family: var(--font-heading);
    font-size: clamp(0.68rem, 2.2vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.25em;
    text-indent: 0.25em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    padding: 0;
    width: 100%;
    text-align: center;
    opacity: 0;
    line-height: 1.5;
  }

  /* Centered FEATURED ∨ at the bottom of the viewport */
  .featured-scroll-cue {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.8);
    padding: var(--space-2xs) var(--space-md);
    opacity: 0;
    transition:
      opacity 0.5s ease,
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .featured-scroll-cue:hover {
    color: var(--color-accent);
    transform: translateX(-50%) translateY(2px);
  }

  .cue-label {
    font-family: var(--font-heading);
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-indent: 0.25em;
    text-transform: uppercase;
  }

  @keyframes cuePulseBounce {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.75;
    }
    50% {
      transform: translateY(4px);
      opacity: 1;
    }
  }

  .cue-chevron {
    animation: cuePulseBounce 2s infinite ease-in-out;
  }

  .hero-section.is-ready .hero-brand-drop {
    animation: logoDropIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }

  .hero-section.is-ready .hero-tagline {
    animation: taglineFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s forwards;
  }

  .hero-section.is-ready .featured-scroll-cue {
    opacity: 1;
    transition-delay: 0.4s;
  }

  @media (max-width: 768px) {
    .hero-tagline {
      letter-spacing: 0.18em;
      text-indent: 0.18em;
    }

    .featured-scroll-cue {
      bottom: var(--space-lg);
    }
  }
</style>
