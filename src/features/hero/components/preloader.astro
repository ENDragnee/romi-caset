---
import { LOGOS } from "@/lib/logos";

interface Props {
  showreelUrl?: string;
}

// showreelUrl is the Backblaze showreel (/api/media/...). Until that has been
// downloaded and cached, the loader plays the bundled fallback clip instead.
const { showreelUrl = "" } = Astro.props;
const L = LOGOS.left;
---

<div id="fly" style="display: none;"></div>
<div class="flyN" id="flyA" style="display: none;"></div>
<div class="flyN" id="flyB" style="display: none;"></div>

<script define:vars={{ showreelUrl, L }}>
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 1 : ms));
  const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const easeIO = (t) => {
    t = clamp(t); // callers pass (t - delay) / span, which can be negative
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  };
  const easeOut = (t) => 1 - Math.pow(1 - clamp(t), 3);
  const easeSharp = (t) =>
    t < 0.5 ? 8 * Math.pow(t, 4) : 1 - Math.pow(-2 * t + 2, 4) / 2;

  // The flying logo + film-negative layers use mix-blend-mode. #page has a CSS transform
  // (menu push), which makes it an isolated stacking context: anything blended INSIDE it
  // sees a transparent backdrop instead of the body's ivory, so the ivory logo paints
  // ivory-on-ivory and is invisible. Hoisting these layers to <body> (like #hdr, which
  // blends correctly) fixes the "logo vanishes before it lands" bug.
  const hoist = () =>
    ["fly", "flyA", "flyB"].forEach((id) => {
      const el = document.getElementById(id);
      if (el && el.parentElement !== document.body)
        document.body.appendChild(el);
    });
  hoist();

  const loaderHTML = () =>
    '<div id="loader"><div id="ld-bg"></div><canvas id="ld-cv"></canvas><video id="ld-vid" muted playsinline loop preload="auto"></video><div id="ld"><svg id="ld-block" aria-hidden="true"></svg><svg class="ldN" id="ldNA" aria-hidden="true"></svg><svg class="ldN" id="ldNB" aria-hidden="true"></svg><div id="ld-txt">loading……………. 0%</div></div></div>';

  function startShowreel(lay) {
    const cv = $("#ld-cv", lay);
    const vid = $("#ld-vid", lay);

    const ctl = {
      el: cv,
      dead: false,
      vis: 0,
      stop() {
        this.dead = true;
        try {
          vid.pause();
        } catch (e) {}
        if (objUrl) URL.revokeObjectURL(objUrl);
      },
      setOpacity(o) {
        cv.style.transition = "none";
        cv.style.opacity = o;
      },
      opacity() {
        return (
          (+getComputedStyle(this.el).opacity || 0) *
          (this.vis === undefined ? 1 : this.vis)
        );
      },
    };

    // ------------------------------------------------------------------
    // SOURCE PRIORITY (first match wins, never swapped mid-intro so the
    // timed shader cuts at 1.0s / 2.29s / 3.46s can't jump):
    //   1. Backend (Backblaze) showreel in Cache Storage  -> instant, from disk
    //   2. Bundled fallback clip in Cache Storage          -> instant, from disk
    //                                                        (+ backend warmed in background)
    //   3. Nothing cached yet -> plain black loader, no footage; the fallback is
    //      cached and the backend warmed in the background after the intro, so
    //      visit #2 plays a video instantly.
    // When a clip plays, the count runs for one play of it (else 3.5s).
    // ------------------------------------------------------------------
    const FALLBACK_VERSION = "2"; // bump when you replace public/videos/hero-fallback.mp4
    const HERO_URL = "/videos/hero-fallback.mp4?v=" + FALLBACK_VERSION;
    const CACHE_NAME = "br-showreel-v1";
    const MAX_BYTES = 120 * 1024 * 1024; // never cache absurdly large files
    const STALE_MS = 24 * 60 * 60 * 1000; // refresh backend copy in background after 24h
    const AFTER_INTRO_MS = 9000; // background caching waits until the intro is done
    const remote =
      showreelUrl && !showreelUrl.startsWith("/videos/") ? showreelUrl : "";
    let objUrl = "";

    ctl.isReady = false; // true once a source is attached and can play
    ctl.ready = new Promise((r) => (ctl._resolveReady = r));
    const markReady = () => {
      if (ctl.isReady) return;
      ctl.isReady = true;
      ctl._resolveReady();
    };

    vid.muted = true;
    vid.defaultMuted = true;
    vid.playsInline = true;

    const openCache = async () => {
      try {
        return "caches" in window ? await caches.open(CACHE_NAME) : null;
      } catch (e) {
        return null;
      }
    };

    const readCached = async (key) => {
      try {
        const c = await openCache();
        const r = c && (await c.match(key));
        return r
          ? { blob: await r.blob(), at: +r.headers.get("x-br-cached-at") || 0 }
          : null;
      } catch (e) {
        return null;
      }
    };

    // Downloads the file into a Blob and caches it (returns null on any failure).
    const download = async (url, key, onProgress, fresh) => {
      try {
        const res = await fetch(url, {
          mode: "cors",
          cache: fresh ? "no-cache" : "default",
        });
        if (!res.ok) return null;
        const total = +res.headers.get("content-length") || 0;
        if (total > MAX_BYTES) return null;
        let blob;
        if (res.body && res.body.getReader) {
          const rd = res.body.getReader();
          const chunks = [];
          let got = 0;
          for (;;) {
            const { done, value } = await rd.read();
            if (done) break;
            chunks.push(value);
            got += value.length;
            if (got > MAX_BYTES) return null;
            if (onProgress)
              onProgress(
                total ? Math.min(got / total, 1) : 1 - Math.exp(-got / 2e6),
              );
          }
          blob = new Blob(chunks, {
            type: res.headers.get("content-type") || "video/mp4",
          });
        } else {
          blob = await res.blob();
        }
        if (!blob.size) return null;
        if (onProgress) onProgress(1);
        try {
          const c = await openCache();
          if (c)
            await c.put(
              key,
              new Response(blob, {
                headers: {
                  "content-type": blob.type || "video/mp4",
                  "x-br-cached-at": String(Date.now()),
                },
              }),
            );
        } catch (e) {
          /* quota / private mode: fine, we still play from the in-memory blob */
        }
        return blob;
      } catch (e) {
        return null; /* offline / CORS blocked */
      }
    };

    // Attach a source and resolve ready when it can actually play (or after a short grace).
    const attach = (src, blob) => {
      if (ctl.dead) return;
      if (blob) {
        objUrl = URL.createObjectURL(blob);
        src = objUrl;
      }
      const done = () => markReady();
      vid.addEventListener("canplay", done, { once: true });
      vid.addEventListener("error", done, { once: true });
      setTimeout(done, 4000);
      vid.src = src;
      const pr = vid.play();
      if (pr && pr.catch) pr.catch(() => {});
    };

    (async () => {
      // 1 + 2: cache lookups (few ms). Capped so storage can never stall the intro.
      const found = await Promise.race([
        (async () => {
          if (remote) {
            const b = await readCached(remote);
            if (b) return { ...b, kind: "remote" };
          }
          const h = await readCached(HERO_URL);
          return h ? { ...h, kind: "hero" } : null;
        })(),
        new Promise((r) => setTimeout(() => r(null), 3000)), // only guards a hung storage backend
      ]);
      if (ctl.dead) return;

      const tag = (v) => (document.documentElement.dataset.reelSource = v); // handy for debugging
      if (found) {
        tag(found.kind === "remote" ? "backend-cache" : "default-cache");
        attach(null, found.blob);
        if (found.kind === "remote") {
          if (Date.now() - found.at > STALE_MS)
            download(remote, remote, null, true);
        } else if (remote) {
          download(remote, remote, null, false); // warm backend for next visit
        }
        return;
      }

      // 3: nothing cached. Run the intro on the plain black loader (no footage),
      //    then cache the fallback and warm the backend once the intro is over.
      tag("none");
      markReady();
      setTimeout(async () => {
        await download(HERO_URL, HERO_URL, null, false);
        if (remote) download(remote, remote, null, false);
      }, AFTER_INTRO_MS);
    })();

    try {
      const gl = cv.getContext("webgl", {
        antialias: false,
        alpha: false,
        preserveDrawingBuffer: false,
      });
      if (!gl) throw 0;

      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      const size = () => {
        cv.width = Math.round(innerWidth * dpr * 0.75);
        cv.height = Math.round(innerHeight * dpr * 0.75);
        gl.viewport(0, 0, cv.width, cv.height);
      };
      size();
      window.addEventListener("resize", size);

      const vs =
        "attribute vec2 p;varying vec2 uv;void main(){uv=p*.5+.5;gl_Position=vec4(p,0.,1.);}";
      const fs = `precision mediump float;varying vec2 uv;uniform sampler2D t;uniform sampler2D tp;uniform vec2 res;uniform vec2 vres;uniform float time;
        uniform float amt;uniform float sph;uniform float cy;uniform float sq;uniform float swl;uniform float up;uniform float kick;uniform float dis;uniform float lw;
        vec2 cover(vec2 u){float sa=res.x/res.y,va=vres.x/vres.y;vec2 s=vec2(1.);if(sa>va)s.y=va/sa;else s.x=sa/va;return (u-.5)*s+.5;}
        vec3 tapM(vec2 u,float m){ if(u.x<0.||u.y<0.||u.x>1.||u.y>1.) return vec3(0.); vec2 v=cover(vec2(u.x,1.-u.y)); return mix(texture2D(t,v).rgb,texture2D(tp,v).rgb,m); }
        vec3 tap(vec2 u){ return tapM(u,max(dis,lw)); }
        void main(){
          float asp=res.x/res.y; vec2 c=vec2(.5);
          vec2 p=uv-c; p.x*=asp; float r=length(p);
          vec2 q=p*(1.+kick*.34*r*r);
          float a=amt*.85*exp(-r*2.2)*sin(time*.6+1.); float s=sin(a),co=cos(a); q=mat2(co,-s,s,co)*q;
          float B=max(amt,kick*.55);
          vec3 sum=vec3(0.); const int N=14;
          for(int i=0;i<N;i++){
            float k=float(i)/float(N-1); float sc=1.-k*B*(.30+.55*r);
            vec2 u=q*sc; u.x/=asp; u+=c;
            vec2 off=normalize(q+1e-4)*B*.009; off.x/=asp;
            sum+=vec3(tap(u+off).r,tap(u).g,tap(u-off).b);
          }
          vec3 col=sum/float(N);
          if(sph>.001){
            vec2 sc2=vec2(0.,cy); vec2 d=p-sc2; float rr=length(d);
            float pw=mix(2.,3.2,sq);
            float rs=pow(pow(abs(d.x/sph),pw)+pow(abs(d.y/sph),pw),1./pw);
            if(rs<1.){
              vec2 n=d/sph/max(rs,1e-4)*rs; float z=sqrt(max(1.-rs*rs,0.));
              float tw=swl*3.2*pow(1.-rs,1.4); float ts=sin(tw),tc=cos(tw);
              vec2 chrome=-n*sph*(.9+1.3*(1.-z));
              vec2 upright=d*(.5+.5*rs);
              vec2 qi=mix(chrome,upright,up); qi=mat2(tc,-ts,ts,tc)*qi+sc2;
              vec3 inner=tapM((qi*vec2(1./asp,1.))+c,0.);
              inner=inner*mix(.55+.45*z,1.,up)+pow(1.-z,3.)*vec3(.55,.7,.8)*(1.-up*.7);
              col=mix(col,inner,smoothstep(1.,.965,rs));
            }
            col+=smoothstep(.9,1.,rs)*(1.-smoothstep(1.,1.06,rs))*vec3(.40,.55,.66)*.32;
          }
          col*=1.-B*.42*smoothstep(.3,1.1,r);
          gl_FragColor=vec4(col,1.);
        }`;

      const sh = (ty, src) => {
        const s = gl.createShader(ty);
        gl.shaderSource(s, src);
        gl.compileShader(s);
        return s;
      };
      const pg = gl.createProgram();
      gl.attachShader(pg, sh(gl.VERTEX_SHADER, vs));
      gl.attachShader(pg, sh(gl.FRAGMENT_SHADER, fs));
      gl.linkProgram(pg);
      gl.useProgram(pg);

      const b = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
        gl.STATIC_DRAW,
      );
      const loc = gl.getAttribLocation(pg, "p");
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const c2 = document.createElement("canvas");
      c2.width = 640;
      c2.height = 360;
      const c2x = c2.getContext("2d");
      const c3 = document.createElement("canvas");
      c3.width = 640;
      c3.height = 360;
      const c3x = c3.getContext("2d");

      const mkTex = () => {
        const x = gl.createTexture();
        gl.bindTexture(gl.TEXTURE_2D, x);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texImage2D(
          gl.TEXTURE_2D,
          0,
          gl.RGBA,
          1,
          1,
          0,
          gl.RGBA,
          gl.UNSIGNED_BYTE,
          new Uint8Array([0, 0, 0, 255]),
        );
        return x;
      };
      const tex = mkTex(),
        texP = mkTex();

      const U = (n) => gl.getUniformLocation(pg, n);
      const u = {};
      [
        "res",
        "vres",
        "time",
        "amt",
        "sph",
        "cy",
        "sq",
        "swl",
        "up",
        "kick",
        "dis",
        "lw",
      ].forEach((k) => (u[k] = U(k)));

      gl.uniform1i(U("t"), 0);
      gl.uniform1i(U("tp"), 1);

      let first = true;
      const t0 = performance.now();
      let lastCT = 0;
      const PLAN = { 1.0: "dissolve", 2.292: "lens", 3.458: "bulge" };
      const PCUTS = Object.keys(PLAN).map(Number);

      const look = () => {
        const ct = vid.currentTime;
        const Lk = {
          amt: 0,
          sph: 0,
          cy: 0,
          sq: 0,
          swl: 0,
          up: 0,
          kick: 0,
          dis: 0,
          lw: 0,
        };
        for (const cc of PCUTS) {
          const dt = ct - cc;
          const kind = PLAN[cc];
          if (kind === "lens") {
            if (dt < 0 || dt >= 0.45) continue;
            const k = dt / 0.45;
            Lk.lw = 1;
            Lk.up = 1;
            Lk.sph = 0.2 + (2.1 - 0.2) * Math.pow(k, 1.6);
            Lk.amt = 0.6 * (1 - k * k * (3 - 2 * k));
          } else if (kind === "bulge") {
            if (dt < 0 || dt >= 0.5) continue;
            Lk.kick = Math.max(Lk.kick, Math.pow(1 - dt / 0.5, 2));
          } else {
            if (dt < 0 || dt >= 0.5) continue;
            Lk.dis = Math.max(Lk.dis, 1 - dt / 0.5);
          }
        }
        return Lk;
      };

      (function frame() {
        if (ctl.dead) {
          window.removeEventListener("resize", size);
          return;
        }
        if (vid.readyState >= 2 && vid.videoWidth) {
          const ct = vid.currentTime;
          if (PCUTS.some((cc) => lastCT < cc && ct >= cc)) {
            c3x.drawImage(c2, 0, 0);
            gl.activeTexture(gl.TEXTURE1);
            gl.bindTexture(gl.TEXTURE_2D, texP);
            gl.texImage2D(
              gl.TEXTURE_2D,
              0,
              gl.RGBA,
              gl.RGBA,
              gl.UNSIGNED_BYTE,
              c3,
            );
          }
          lastCT = ct;
          c2x.drawImage(vid, 0, 0, c2.width, c2.height);
          gl.activeTexture(gl.TEXTURE0);
          gl.bindTexture(gl.TEXTURE_2D, tex);
          gl.texImage2D(
            gl.TEXTURE_2D,
            0,
            gl.RGBA,
            gl.RGBA,
            gl.UNSIGNED_BYTE,
            c2,
          );

          gl.uniform2f(u.res, cv.width, cv.height);
          gl.uniform2f(u.vres, c2.width, c2.height);
          gl.uniform1f(u.time, (performance.now() - t0) / 1000);

          const Lk = look();
          for (const k in Lk) gl.uniform1f(u[k], Lk[k]);

          ctl.vis = 1;
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          if (first) {
            first = false;
            cv.style.transition = "none";
            cv.style.opacity = "1";
          }
        }
        requestAnimationFrame(frame);
      })();
    } catch (e) {
      vid.style.cssText =
        "position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:1";
      ctl.el = vid;
    }
    return ctl;
  }

  async function playIntro() {
    const root = document.documentElement;
    root.classList.add("locked");
    hoist();

    const existing = $("#loader");
    if (existing) existing.remove();
    document.body.insertAdjacentHTML("beforeend", loaderHTML());

    const lay = $("#loader");
    lay.style.background = "#000";

    // Arriving at home through the router (not first load): fade the loader in over the departing page
    const replay = (window.__brIntroRuns = (window.__brIntroRuns || 0) + 1) > 1;
    if (replay && !reduce) {
      lay.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 380,
        easing: "ease",
      });
    }

    const ld = $("#ld");
    const blk = $("#ld-block");
    const txt = $("#ld-txt");

    const NEG_A = "#FFB474",
      NEG_B = "#5A2408";

    // Counting phase: the solid logo shell (no letters) fills left to right.
    // Ivory + difference inverts the footage under it; the two tinted copies
    // turn that inversion into a colour-negative film look.
    const vb = `${L.bx} ${L.by} ${L.bw} ${L.bh}`;
    const blkSVG = (id, fill) =>
      `<defs><clipPath id="ldc${id}"><rect class="ldr" x="${L.bx - 3}" y="${L.by - 3}" width="0" height="${L.bh + 6}"/></clipPath></defs><path d="${L.shell}" clip-path="url(#ldc${id})"${fill ? ` fill="${fill}"` : ""}/>`;
    blk.setAttribute("viewBox", vb);
    blk.innerHTML = blkSVG("", "");
    const negs = [$("#ldNA"), $("#ldNB")];
    negs.forEach((s, i) => {
      s.setAttribute("viewBox", vb);
      s.innerHTML = blkSVG(i ? "B" : "A", i ? NEG_B : NEG_A);
      s.style.display = "block";
      s.style.opacity = "0";
    });
    blk.style.display = "block";

    const ldrs = $$(".ldr", lay);
    const setWipe = (pct) => {
      const w = pct >= 100 ? L.bw + 6 : (clamp(pct, 0, 100) / 100) * L.bw + 3;
      for (const r of ldrs) r.setAttribute("width", w);
    };

    const reel = startShowreel(lay);

    const page = $("#page");

    // ---- Build the flying logo layers up-front (hidden) so mask parsing and
    // ---- first raster happen while the counter runs, not on the first flight frame.
    const NEG_FILLS = ["#E1E1D7", NEG_A, NEG_B];
    const flyEls = [$("#fly"), $("#flyA"), $("#flyB")];
    const logoSvg = $("#logoL svg");

    // Each fly layer is the full navbar artwork: the shell with the letters
    // masked out by a growing rect (they wipe in during the flight) and the
    // FILMWORK tagline clipped below the shell so it can slide up into place.
    const flySVG = (i, fill) =>
      `<svg viewBox="0 0 ${L.w} ${L.h}"><defs><clipPath id="cl${i}"><rect class="clr" x="${L.bx - 4}" y="${L.by - 4}" width="0" height="${L.bh + 8}"/></clipPath>` +
      `<clipPath id="ct${i}"><rect x="${L.bx - 4}" y="${L.by + L.bh}" width="${L.bw + 8}" height="${L.h - L.by - L.bh}"/></clipPath>` +
      `<mask id="mk${i}" maskUnits="userSpaceOnUse" x="0" y="0" width="${L.w}" height="${L.h}"><rect width="${L.w}" height="${L.h}" fill="#fff"/><path d="${L.inner}" fill-rule="evenodd" fill="#000" clip-path="url(#cl${i})"/></mask></defs>` +
      `<path d="${L.shell}" fill="${fill}" mask="url(#mk${i})"/>` +
      `<g clip-path="url(#ct${i})"><path class="fl-tag" d="${L.tag}" fill-rule="evenodd" fill="${fill}"/></g></svg>`;

    // Built now (hidden) so the SVG is parsed before the flight; shown at step 3.
    flyEls.forEach((el, i) => {
      el.style.cssText = "display:none;";
      el.innerHTML = flySVG(i, NEG_FILLS[i]);
    });
    const clrs = $$(".clr");
    const tags = $$(".fl-tag");

    // 1a. Wait for the source decision: a cached clip that can play (~instant,
    //     from disk) or none at all on a first visit.
    await reel.ready;

    // 1b. Cinematic counter 0% -> 100%. The video starts playing at the same moment,
    //     so its timed cuts (1.0s / 2.29s / 3.46s) always land inside this window.
    //     With a clip the count runs for one play of it; without one, 3.5s.
    const vidDur = $("#ld-vid", lay).duration;
    const DUR = reduce
      ? 600
      : Number.isFinite(vidDur) && vidDur > 0
        ? clamp(vidDur * 1000, 2000, 15000)
        : 3500;
    const t0 = performance.now();

    await new Promise((res) => {
      let lastPct = -1;
      function tick(now) {
        const t = clamp((now - t0) / DUR);
        const pct = Math.round(100 * easeIO(t));
        if (pct !== lastPct) {
          lastPct = pct;
          txt.textContent = "loading……………. " + pct + "%";
          setWipe(pct);
        }
        const vo = reel.opacity();
        for (const s of negs) s.style.opacity = vo;

        if (t < 1) requestAnimationFrame(tick);
        else res();
      }
      requestAnimationFrame(tick);
    });

    txt.textContent = "loading……………. 100%";
    setWipe(100);

    await sleep(320);
    txt.style.opacity = "0";
    await sleep(380);

    // 2. Geometry (all layout reads batched, once)
    const target = logoSvg?.getBoundingClientRect();
    if (!target || !target.width) {
      reel.stop();
      lay.remove();
      flyEls.forEach((el) => {
        el.style.display = "none";
        el.innerHTML = "";
      });
      document.body.classList.remove("pre", "pre-logo");
      root.classList.remove("locked");
      return;
    }

    // target is the navbar's full L.w×L.h artwork; the loader block is just
    // the shell's bounding box, so scale/translate around the shell centre.
    const s = target.width / L.w;
    const fcx = (L.bx + L.bw / 2) * s;
    const fcy = (L.by + L.bh / 2) * s;
    const b0 = blk.getBoundingClientRect();
    const k0 = b0.width / (L.bw * s);
    const dx0 = b0.left + b0.width / 2 - (target.left + fcx);
    const dy0 = b0.top + b0.height / 2 - (target.top + fcy);
    const vo0 = reel.opacity();

    // Park the cards below the fold so they can rise as the logo lands. Done
    // here, not at boot: this inline script runs before the grid is parsed.
    if (page)
      $$(".proj.rise:not(.in)", page).forEach((el) => el.classList.add("fb"));

    // 3. Swap loader block -> fly layers (same frame, no flicker). The tinted
    //    film-negative copies are only needed while footage is visible.
    const flyT = (e) =>
      `translate(${dx0 * (1 - e)}px,${dy0 * (1 - e)}px) scale(${1 + (k0 - 1) * (1 - e)})`;
    const live = vo0 > 0.001 ? flyEls : [flyEls[0]];
    live.forEach((el) => {
      el.style.cssText =
        `display:block;left:${target.left}px;top:${target.top}px;` +
        `width:${target.width}px;height:${target.height}px;` +
        `transform-origin:${fcx}px ${fcy}px;transform:${flyT(0)}`;
    });
    flyEls[1].style.opacity = flyEls[2].style.opacity = vo0.toFixed(3);
    blk.style.display = "none";
    negs.forEach((n) => (n.style.display = "none"));
    ld.style.visibility = "hidden";

    const bg = $("#ld-bg", lay);
    bg.style.display = "block";
    lay.style.background = "transparent";
    reel.el.style.transition = "none";
    const reel0 = parseFloat(getComputedStyle(reel.el).opacity) || 0;

    // 4. The flight, driven per frame on the main thread like the reference.
    //    (Compositor-driven WAAPI transforms on these blend-mode layers left a
    //    ghost copy of the logo at its landing spot in iOS Safari.)
    const TT = reduce ? 300 : 1800;
    const t_start = performance.now();
    let shown = false;

    await new Promise((res) => {
      function frame(now) {
        const t = clamp((now - t_start) / TT);
        const tr = flyT(easeSharp(t));
        for (const el of live) el.style.transform = tr;

        // Knock the letters out of the shell, left to right
        const w = (L.bw + 8) * easeIO((t - 0.1) / 0.62);
        for (const r of clrs) r.setAttribute("width", w);

        // Unfold FILMWORK: slide the tagline up into place from below the shell
        const u = easeOut((t - 0.6) / 0.4);
        const tt = `translate(0 ${(1 - u) * (L.h - L.by - L.bh) * 0.9})`;
        for (const tg of tags) tg.setAttribute("transform", tt);

        // Backdrop, footage and negative tint fade out between 15% and 70%
        const fadeF = 1 - clamp((t - 0.15) / 0.55);
        bg.style.opacity = fadeF;
        reel.el.style.opacity = reel0 * fadeF;
        flyEls[1].style.opacity = flyEls[2].style.opacity = (
          fadeF * vo0
        ).toFixed(3);

        // Cards rise as the logo lands (single class flip, CSS handles the rest)
        if (!shown && t > 0.45) {
          shown = true;
          document.body.classList.add("pre-logo");
          document.body.classList.remove("pre");
          if (page) {
            $$(".proj.rise.fb", page).forEach((el, i) => {
              setTimeout(() => el.classList.add("in"), 120 * Math.min(i, 8));
            });
          }
        }

        if (t < 1) requestAnimationFrame(frame);
        else res();
      }
      requestAnimationFrame(frame);
    });

    // 5. Hand-off to the real navbar logo: swap in a single frame, no cross-fade, no pop.
    const lg = $("#hdr .logo");
    if (lg) lg.style.transition = "none";
    document.body.classList.remove("pre-logo", "pre");
    if (lg) void lg.offsetWidth;
    // IMPORTANT: remove the fly layers in this SAME task. Both they and #hdr use
    // mix-blend-mode:difference, so if they ever overlap for even one frame the
    // navbar logo is differenced against the black fly logo and renders ivory (invisible).
    reel.stop();
    flyEls.forEach((el) => {
      el.style.display = "none";
      el.innerHTML = "";
    });
    lay.remove();
    if (lg) {
      requestAnimationFrame(() => {
        lg.style.transition = "";
      });
    }

    root.classList.remove("locked");
  }

  let introRunning = false;
  async function bootIntro() {
    const B = document.body;
    // Run ONLY on the landing page: body.pre + route "home" + this page actually contains the
    // preloader markup. Anything else (about/contact with a missing route prop, a stale listener
    // after a ClientRouter navigation...) must never build a loader, and must never leave one behind:
    // without this page's CSS an orphaned #loader renders as a raw, playing <video> at the bottom.
    const isLanding =
      B.classList.contains("pre") &&
      B.dataset.route === "home" &&
      !!document.getElementById("fly");
    if (!isLanding) {
      document.getElementById("loader")?.remove();
      return;
    }
    if (introRunning) return;
    introRunning = true;
    try {
      await playIntro();
    } finally {
      introRunning = false;
    }
  }
  bootIntro();
  document.addEventListener("astro:page-load", bootIntro);
</script>

