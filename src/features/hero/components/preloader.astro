---
import { LOGOS } from "@/lib/logos";

interface Props {
  showreelUrl?: string;
}

// Default fallback is explicitly set to /videos/hero-video.mp4
const { showreelUrl = "/videos/hero-video.mp4" } = Astro.props;
---

<div class="neg" id="negA" aria-hidden="true"></div>
<div class="neg" id="negB" aria-hidden="true"></div>

<div id="fly" style="display: none;"></div>
<div class="flyN" id="flyA" style="display: none;"></div>
<div class="flyN" id="flyB" style="display: none;"></div>

<script define:vars={{ showreelUrl, LOGOS }}>
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 1 : ms));
  const clamp = (v, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const easeIO = (t) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  const easeOut = (t) => 1 - Math.pow(1 - clamp(t), 3);
  const easeSharp = (t) =>
    t < 0.5 ? 8 * Math.pow(t, 4) : 1 - Math.pow(-2 * t + 2, 4) / 2;

  const loaderHTML = () =>
    '<div id="loader"><canvas id="ld-cv"></canvas><video id="ld-vid" muted playsinline loop preload="auto"></video><div id="ld"><svg id="ld-block" viewBox="0 0 3318 1274" aria-hidden="true"></svg><svg class="ldN" id="ldNA" aria-hidden="true"></svg><svg class="ldN" id="ldNB" aria-hidden="true"></svg><div id="ld-txt">loading……………. 0%</div></div></div>';

  function startShowreel(lay) {
    const cv = $("#ld-cv", lay);
    const vid = $("#ld-vid", lay);

    const ctl = {
      el: cv,
      dead: false,
      vis: 0,
      stop() {
        this.dead = true;
        try {
          vid.pause();
        } catch (e) {}
      },
      setOpacity(o) {
        cv.style.transition = "none";
        cv.style.opacity = o;
      },
      opacity() {
        return (
          (+getComputedStyle(this.el).opacity || 0) *
          (this.vis === undefined ? 1 : this.vis)
        );
      },
    };

    // 1. Immediately start playing the local fallback video
    const fallbackSrc = "/videos/hero-video.mp4";
    vid.muted = true;
    vid.defaultMuted = true;
    vid.playsInline = true;
    vid.src = fallbackSrc;
    const pr = vid.play();
    if (pr && pr.catch) pr.catch(() => {});

    // 2. If a backend or cached video was passed, probe it in background and swap without stalling
    if (showreelUrl && showreelUrl !== fallbackSrc) {
      const probe = document.createElement("video");
      probe.src = showreelUrl;
      probe.muted = true;
      probe.preload = "auto";
      probe.oncanplay = () => {
        if (!ctl.dead) {
          vid.src = showreelUrl;
          vid.play().catch(() => {});
        }
      };
    }

    try {
      const gl = cv.getContext("webgl", {
        antialias: false,
        alpha: false,
        preserveDrawingBuffer: false,
      });
      if (!gl) throw 0;

      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      const size = () => {
        cv.width = Math.round(innerWidth * dpr * 0.75);
        cv.height = Math.round(innerHeight * dpr * 0.75);
        gl.viewport(0, 0, cv.width, cv.height);
      };
      size();
      window.addEventListener("resize", size);

      const vs =
        "attribute vec2 p;varying vec2 uv;void main(){uv=p*.5+.5;gl_Position=vec4(p,0.,1.);}";
      const fs = `precision mediump float;varying vec2 uv;uniform sampler2D t;uniform sampler2D tp;uniform vec2 res;uniform vec2 vres;uniform float time;
        uniform float amt;uniform float sph;uniform float cy;uniform float sq;uniform float swl;uniform float up;uniform float kick;uniform float dis;uniform float lw;
        vec2 cover(vec2 u){float sa=res.x/res.y,va=vres.x/vres.y;vec2 s=vec2(1.);if(sa>va)s.y=va/sa;else s.x=sa/va;return (u-.5)*s+.5;}
        vec3 tapM(vec2 u,float m){ if(u.x<0.||u.y<0.||u.x>1.||u.y>1.) return vec3(0.); vec2 v=cover(vec2(u.x,1.-u.y)); return mix(texture2D(t,v).rgb,texture2D(tp,v).rgb,m); }
        vec3 tap(vec2 u){ return tapM(u,max(dis,lw)); }
        void main(){
          float asp=res.x/res.y; vec2 c=vec2(.5);
          vec2 p=uv-c; p.x*=asp; float r=length(p);
          vec2 q=p*(1.+kick*.34*r*r);
          float a=amt*.85*exp(-r*2.2)*sin(time*.6+1.); float s=sin(a),co=cos(a); q=mat2(co,-s,s,co)*q;
          float B=max(amt,kick*.55);
          vec3 sum=vec3(0.); const int N=14;
          for(int i=0;i<N;i++){
            float k=float(i)/float(N-1); float sc=1.-k*B*(.30+.55*r);
            vec2 u=q*sc; u.x/=asp; u+=c;
            vec2 off=normalize(q+1e-4)*B*.009; off.x/=asp;
            sum+=vec3(tap(u+off).r,tap(u).g,tap(u-off).b);
          }
          vec3 col=sum/float(N);
          if(sph>.001){
            vec2 sc2=vec2(0.,cy); vec2 d=p-sc2; float rr=length(d);
            float pw=mix(2.,3.2,sq);
            float rs=pow(pow(abs(d.x/sph),pw)+pow(abs(d.y/sph),pw),1./pw);
            if(rs<1.){
              vec2 n=d/sph/max(rs,1e-4)*rs; float z=sqrt(max(1.-rs*rs,0.));
              float tw=swl*3.2*pow(1.-rs,1.4); float ts=sin(tw),tc=cos(tw);
              vec2 chrome=-n*sph*(.9+1.3*(1.-z));
              vec2 upright=d*(.5+.5*rs);
              vec2 qi=mix(chrome,upright,up); qi=mat2(tc,-ts,ts,tc)*qi+sc2;
              vec3 inner=tapM((qi*vec2(1./asp,1.))+c,0.);
              inner=inner*mix(.55+.45*z,1.,up)+pow(1.-z,3.)*vec3(.55,.7,.8)*(1.-up*.7);
              col=mix(col,inner,smoothstep(1.,.965,rs));
            }
            col+=smoothstep(.9,1.,rs)*(1.-smoothstep(1.,1.06,rs))*vec3(.40,.55,.66)*.32;
          }
          col*=1.-B*.42*smoothstep(.3,1.1,r);
          gl_FragColor=vec4(col,1.);
        }`;

      const sh = (ty, src) => {
        const s = gl.createShader(ty);
        gl.shaderSource(s, src);
        gl.compileShader(s);
        return s;
      };
      const pg = gl.createProgram();
      gl.attachShader(pg, sh(gl.VERTEX_SHADER, vs));
      gl.attachShader(pg, sh(gl.FRAGMENT_SHADER, fs));
      gl.linkProgram(pg);
      gl.useProgram(pg);

      const b = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, b);
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
        gl.STATIC_DRAW,
      );
      const loc = gl.getAttribLocation(pg, "p");
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const c2 = document.createElement("canvas");
      c2.width = 640;
      c2.height = 360;
      const c2x = c2.getContext("2d");
      const c3 = document.createElement("canvas");
      c3.width = 640;
      c3.height = 360;
      const c3x = c3.getContext("2d");

      const mkTex = () => {
        const x = gl.createTexture();
        gl.bindTexture(gl.TEXTURE_2D, x);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
        gl.texImage2D(
          gl.TEXTURE_2D,
          0,
          gl.RGBA,
          1,
          1,
          0,
          gl.RGBA,
          gl.UNSIGNED_BYTE,
          new Uint8Array([0, 0, 0, 255]),
        );
        return x;
      };
      const tex = mkTex(),
        texP = mkTex();

      const U = (n) => gl.getUniformLocation(pg, n);
      const u = {};
      [
        "res",
        "vres",
        "time",
        "amt",
        "sph",
        "cy",
        "sq",
        "swl",
        "up",
        "kick",
        "dis",
        "lw",
      ].forEach((k) => (u[k] = U(k)));

      gl.uniform1i(U("t"), 0);
      gl.uniform1i(U("tp"), 1);

      let first = true;
      const t0 = performance.now();
      let lastCT = 0;
      const PLAN = { 1.0: "dissolve", 2.292: "lens", 3.458: "bulge" };
      const PCUTS = Object.keys(PLAN).map(Number);

      const look = () => {
        const ct = vid.currentTime;
        const Lk = {
          amt: 0,
          sph: 0,
          cy: 0,
          sq: 0,
          swl: 0,
          up: 0,
          kick: 0,
          dis: 0,
          lw: 0,
        };
        for (const cc of PCUTS) {
          const dt = ct - cc;
          const kind = PLAN[cc];
          if (kind === "lens") {
            if (dt < 0 || dt >= 0.45) continue;
            const k = dt / 0.45;
            Lk.lw = 1;
            Lk.up = 1;
            Lk.sph = 0.2 + (2.1 - 0.2) * Math.pow(k, 1.6);
            Lk.amt = 0.6 * (1 - k * k * (3 - 2 * k));
          } else if (kind === "bulge") {
            if (dt < 0 || dt >= 0.5) continue;
            Lk.kick = Math.max(Lk.kick, Math.pow(1 - dt / 0.5, 2));
          } else {
            if (dt < 0 || dt >= 0.5) continue;
            Lk.dis = Math.max(Lk.dis, 1 - dt / 0.5);
          }
        }
        return Lk;
      };

      (function frame() {
        if (ctl.dead) {
          window.removeEventListener("resize", size);
          return;
        }
        if (vid.readyState >= 2 && vid.videoWidth) {
          const ct = vid.currentTime;
          if (PCUTS.some((cc) => lastCT < cc && ct >= cc)) {
            c3x.drawImage(c2, 0, 0);
            gl.activeTexture(gl.TEXTURE1);
            gl.bindTexture(gl.TEXTURE_2D, texP);
            gl.texImage2D(
              gl.TEXTURE_2D,
              0,
              gl.RGBA,
              gl.RGBA,
              gl.UNSIGNED_BYTE,
              c3,
            );
          }
          lastCT = ct;
          c2x.drawImage(vid, 0, 0, c2.width, c2.height);
          gl.activeTexture(gl.TEXTURE0);
          gl.bindTexture(gl.TEXTURE_2D, tex);
          gl.texImage2D(
            gl.TEXTURE_2D,
            0,
            gl.RGBA,
            gl.RGBA,
            gl.UNSIGNED_BYTE,
            c2,
          );

          gl.uniform2f(u.res, cv.width, cv.height);
          gl.uniform2f(u.vres, c2.width, c2.height);
          gl.uniform1f(u.time, (performance.now() - t0) / 1000);

          const Lk = look();
          for (const k in Lk) gl.uniform1f(u[k], Lk[k]);

          ctl.vis = 1;
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          if (first) {
            first = false;
            cv.style.transition = "none";
            cv.style.opacity = "1";
          }
        }
        requestAnimationFrame(frame);
      })();
    } catch (e) {
      vid.style.cssText =
        "position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:1";
      ctl.el = vid;
    }
    return ctl;
  }

  async function playIntro() {
    const root = document.documentElement;
    root.classList.add("locked");

    const existing = $("#loader");
    if (existing) existing.remove();
    document.body.insertAdjacentHTML("beforeend", loaderHTML());

    const lay = $("#loader");
    lay.style.background = "#000";

    const L = LOGOS.left;
    const ld = $("#ld");
    const blk = $("#ld-block");
    const txt = $("#ld-txt");

    blk.setAttribute("viewBox", `${L.bx} ${L.by} ${L.bw} ${L.bh}`);
    const NEG_A = "#FFB474",
      NEG_B = "#5A2408";

    const blkSVG = (id, fill) =>
      '<defs><clipPath id="ldc' +
      id +
      '"><rect class="ldr" x="' +
      (L.bx - 3) +
      '" y="' +
      (L.by - 3) +
      '" width="0" height="' +
      (L.bh + 6) +
      '"/></clipPath></defs>' +
      '<path d="' +
      L.shell +
      '" clip-path="url(#ldc' +
      id +
      ')"' +
      (fill ? ' fill="' + fill + '"' : "") +
      "/>";

    blk.innerHTML = blkSVG("", "");
    const negs = [$("#ldNA"), $("#ldNB")];
    negs.forEach((s, i) => {
      s.setAttribute("viewBox", `${L.bx} ${L.by} ${L.bw} ${L.bh}`);
      s.innerHTML = blkSVG(i ? "B" : "A", i ? NEG_B : NEG_A);
      s.style.display = "block";
      s.style.opacity = "0";
    });
    blk.style.display = "block";

    const ldrs = $$(".ldr", lay);
    const reel = startShowreel(lay);

    const page = $("#page");
    if (page) {
      $$(".proj.rise", page).forEach((el) => {
        el.classList.add("fb");
      });
    }

    // 1. Ticking Counter from 0% -> 100%
    const DUR = reduce ? 600 : 3500;
    const t0 = performance.now();

    await new Promise((res) => {
      function tick(now) {
        const t = clamp((now - t0) / DUR);
        const pct = Math.round(easeIO(t) * 100);
        txt.textContent = "loading……………. " + pct + "%";
        ldrs.forEach((r) =>
          r.setAttribute(
            "width",
            pct >= 100 ? L.bw + 6 : (pct / 100) * L.bw + 3,
          ),
        );

        const vo = reel.opacity();
        negs.forEach((s) => (s.style.opacity = vo));

        if (t < 1) requestAnimationFrame(tick);
        else res();
      }
      requestAnimationFrame(tick);
    });

    txt.textContent = "loading……………. 100%";
    ldrs.forEach((r) => r.setAttribute("width", L.bw + 6));
    await sleep(320);
    txt.style.opacity = "0";
    await sleep(380);

    // 2. Exact Target Coordinates Lookup
    const target = $("#logoL svg")?.getBoundingClientRect();
    if (!target) {
      lay.remove();
      document.body.classList.remove("pre");
      root.classList.remove("locked");
      return;
    }

    const s = target.width / L.w;
    const fcx = (L.bx + L.bw / 2) * s;
    const fcy = (L.by + L.bh / 2) * s;
    const b0 = blk.getBoundingClientRect();
    const k0 = b0.width / (L.bw * s);
    const dx0 = b0.left + b0.width / 2 - (target.left + fcx);
    const dy0 = b0.top + b0.height / 2 - (target.top + fcy);

    const flyEls = [$("#fly"), $("#flyA"), $("#flyB")];
    const fills = ["#E1E1D7", NEG_A, NEG_B];

    const flySVG = (sKey, fill) =>
      '<svg viewBox="0 0 ' +
      L.w +
      " " +
      L.h +
      '">' +
      "<defs>" +
      '<clipPath id="cl' +
      sKey +
      '"><rect class="clr" x="' +
      (L.bx - 4) +
      '" y="' +
      (L.by - 4) +
      '" width="0" height="' +
      (L.bh + 8) +
      '"/></clipPath>' +
      '<clipPath id="ct' +
      sKey +
      '"><rect x="' +
      (L.bx - 4) +
      '" y="' +
      (L.by + L.bh) +
      '" width="' +
      (L.bw + 8) +
      '" height="' +
      (L.h - L.by - L.bh) +
      '"/></clipPath>' +
      '<mask id="mk' +
      sKey +
      '" maskUnits="userSpaceOnUse" x="0" y="0" width="' +
      L.w +
      '" height="' +
      L.h +
      '"><rect width="' +
      L.w +
      '" height="' +
      L.h +
      '" fill="#fff"/><path d="' +
      L.inner +
      '" fill-rule="evenodd" fill="#000" clip-path="url(#cl' +
      sKey +
      ')"/></mask>' +
      "</defs>" +
      '<path d="' +
      L.shell +
      '" fill="' +
      fill +
      '" mask="url(#mk' +
      sKey +
      ')"/>' +
      '<g clip-path="url(#ct' +
      sKey +
      ')"><path class="fl-tag" d="' +
      L.tag +
      '" fill-rule="evenodd" fill="' +
      fill +
      '"/></g>' +
      "</svg>";

    flyEls.forEach((el, i) => {
      el.style.cssText = `display:block;left:${target.left}px;top:${target.top}px;width:${target.width}px;height:${target.height}px;transform-origin:${fcx}px ${fcy}px;position:fixed;z-index:${120 + i};pointer-events:none;`;
      el.innerHTML = flySVG(i, fills[i]);
    });

    blk.style.display = "none";
    negs.forEach((s) => (s.style.display = "none"));
    ld.style.visibility = "hidden";
    flyEls.forEach(
      (el) =>
        (el.style.transform = `translate3d(${dx0}px,${dy0}px,0) scale(${k0})`),
    );

    const clrs = $$(".clr");
    const tags = $$(".fl-tag");
    const vo0 = reel.opacity();

    // Slower, smooth flight duration matching reference (2600ms)
    const TT = reduce ? 300 : 2600;
    const ts = performance.now();
    let shown = false;

    await new Promise((res) => {
      function frame(now) {
        const t = clamp((now - ts) / TT);
        const e = easeSharp(t);

        flyEls.forEach((el) => {
          el.style.transform = `translate3d(${dx0 * (1 - e)}px,${dy0 * (1 - e)}px,0) scale(${1 + (k0 - 1) * (1 - e)})`;
        });

        // Wiping across BINI ROMI
        clrs.forEach((clr) =>
          clr.setAttribute(
            "width",
            String((L.bw + 8) * easeIO((t - 0.08) / 0.65)),
          ),
        );

        // Unfolding FILMWORK
        const u = easeOut((t - 0.55) / 0.45);
        tags.forEach((tag) =>
          tag.setAttribute(
            "transform",
            `translate(0 ${(1 - u) * (L.h - L.by - L.bh) * 0.9})`,
          ),
        );

        // Gradual fade out
        const fadeF = 1 - clamp((t - 0.12) / 0.62);
        lay.style.background = `color-mix(in srgb,var(--bg) ${Math.round(fadeF * 100)}%,transparent)`;
        reel.setOpacity(fadeF);
        flyEls[1].style.opacity = flyEls[2].style.opacity = (
          fadeF * vo0
        ).toFixed(3);

        if (!shown && t > 0.48) {
          shown = true;
          document.body.classList.add("pre-logo");
          document.body.classList.remove("pre");

          if (page) {
            $$(".proj.rise.fb", page).forEach((el, i) => {
              setTimeout(() => el.classList.add("in"), 120 * Math.min(i, 8));
            });
          }
        }

        if (t < 1) requestAnimationFrame(frame);
        else res();
      }
      requestAnimationFrame(frame);
    });

    const lg = $("#hdr .logo");
    if (lg) lg.style.transition = "none";
    document.body.classList.remove("pre-logo", "pre");
    if (lg) void lg.offsetWidth;
    reel.stop();

    flyEls.forEach((el) => {
      el.style.display = "none";
      el.innerHTML = "";
    });
    lay.remove();
    if (lg) {
      requestAnimationFrame(() => {
        lg.style.transition = "";
      });
    }

    root.classList.remove("locked");
  }

  // Live Negative Filter Loop
  (function runNegative() {
    const mk = (k) => {
      const L = LOGOS[k];
      const svgStr =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' +
        L.w +
        " " +
        L.h +
        '"><path fill-rule="evenodd" d="' +
        L.shell +
        " " +
        L.inner +
        " " +
        L.tag +
        '"/></svg>';
      return 'url("data:image/svg+xml,' + encodeURIComponent(svgStr) + '")';
    };
    const masks = { left: mk("left"), full: mk("full") };
    const layers = [$("#negA"), $("#negB")];
    const hdr = $("#hdr");
    let lastMask = "",
      lastKey = "";

    layers.forEach((l) => {
      if (l) {
        l.style.webkitMaskImage = masks.left;
        l.style.maskImage = masks.left;
      }
    });

    (function frame() {
      const B = document.body;
      const off =
        B.classList.contains("pre") || B.classList.contains("pre-logo");
      const full = B.dataset.route === "contact" || B.dataset.route === "about";
      const svg = $(full ? "#logoF svg" : "#logoL svg");
      let d = "",
        key = "off";

      if (!off && svg && hdr) {
        const r = svg.getBoundingClientRect();
        for (const el of document.querySelectorAll(
          ".thumb, .still, .pj-video",
        )) {
          const q = el.getBoundingClientRect();
          if (
            q.bottom <= r.top ||
            q.top >= r.bottom ||
            q.right <= r.left ||
            q.left >= r.right
          )
            continue;
          const img = el.querySelector("img");
          if (img && +getComputedStyle(img).opacity < 0.5) continue;
          const x0 = Math.max(q.left, r.left) - r.left;
          const y0 = Math.max(q.top, r.top) - r.top;
          const x1 = Math.min(q.right, r.right) - r.left;
          const y1 = Math.min(q.bottom, r.bottom) - r.top;
          d += `M${x0.toFixed(1)} ${y0.toFixed(1)}H${x1.toFixed(1)}V${y1.toFixed(1)}H${x0.toFixed(1)}Z`;
        }
        const op = getComputedStyle(hdr).opacity;
        key = `${r.left.toFixed(1)},${r.top.toFixed(1)},${r.width.toFixed(1)},${r.height.toFixed(1)}|${d}|${op}`;
        if (key !== lastKey) {
          const m = full ? masks.full : masks.left;
          layers.forEach((l) => {
            if (!l) return;
            l.style.left = r.left + "px";
            l.style.top = r.top + "px";
            l.style.width = r.width + "px";
            l.style.height = r.height + "px";
            if (m !== lastMask) {
              l.style.webkitMaskImage = m;
              l.style.maskImage = m;
            }
            l.style.clipPath = d ? `path('${d}')` : "inset(50%)";
            l.style.opacity = d ? op : "0";
          });
          lastMask = m;
        }
      } else if (lastKey !== "off") {
        layers.forEach((l) => {
          if (l) l.style.opacity = "0";
        });
      }
      lastKey = key;
      requestAnimationFrame(frame);
    })();
  })();

  playIntro();
  document.addEventListener("astro:page-load", playIntro);
</script>

<style>
  .neg {
    position: fixed;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    z-index: 51;
    pointer-events: none;
    opacity: 0;
