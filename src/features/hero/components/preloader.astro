---

---

<div id="preloader" class="preloader-screen" aria-hidden="false">
  {/* Center logo stage */}
  <div class="preloader-center-content">
    <div class="preloader-logo-wrap" id="preloader-logo-wrap">
      <img
        src="/images/logo.png"
        alt="KASET PRODUCTION"
        class="preloader-logo"
        id="preloader-logo"
        draggable="false"
      />
    </div>

    {/* Percentage Counter & Subtitle Status */}
    <div class="preloader-meta-group" id="preloader-meta-group">
      <div id="preloader-percentage" class="percentage-counter">0%</div>
      <div id="preloader-status-text" class="status-stage-text">
        CONNECTING TO ARCHIVE...
      </div>
    </div>
  </div>
</div>

<script>
  let preloaderRaf: number | null = null;

  function RunPreloader() {
    const preloaderEl = document.querySelector<HTMLElement>("#preloader");
    const logoWrapEl = document.querySelector<HTMLElement>(
      "#preloader-logo-wrap",
    );
    const percentEl = document.querySelector<HTMLElement>(
      "#preloader-percentage",
    );
    const statusEl = document.querySelector<HTMLElement>(
      "#preloader-status-text",
    );
    const metaGroupEl = document.querySelector<HTMLElement>(
      "#preloader-meta-group",
    );
    const heroSection = document.querySelector<HTMLElement>("#hero-section");
    const video =
      document.querySelector<HTMLVideoElement>("#hero-video-a") ||
      document.querySelector<HTMLVideoElement>("#hero-video");

    // Nav logo — hide until the fly-in lands
    const navLogoImg = document.querySelector<HTMLElement>(
      "#main-nav-header .logo-img",
    );

    if (!preloaderEl || !logoWrapEl || !percentEl) return;

    const preloader = preloaderEl;
    const percent = percentEl;

    if (preloaderRaf) {
      cancelAnimationFrame(preloaderRaf);
      preloaderRaf = null;
    }

    preloader.style.display = "flex";
    preloader.classList.remove("fade-out");
    percent.textContent = "0%";
    if (statusEl) statusEl.textContent = "CONNECTING TO ARCHIVE...";
    document.body.style.overflow = "hidden";

    // Hide the real nav logo so our flying clone is the only one
    if (navLogoImg) {
      navLogoImg.style.opacity = "0";
      navLogoImg.style.transition = "none";
    }

    let progress = 0;
    let videoReady = false;

    if (video) {
      if (video.readyState >= 2 || video.currentTime > 0) {
        videoReady = true;
      } else {
        const markReady = () => {
          videoReady = true;
        };
        video.addEventListener("canplay", markReady, { once: true });
        video.addEventListener("playing", markReady, { once: true });
        video.addEventListener("loadeddata", markReady, { once: true });
      }
    } else {
      videoReady = true;
    }

    const startTime = performance.now();
    const minDuration = 2500;

    function updateProgress(now: number) {
      const elapsed = now - startTime;
      const timeRatio = Math.min(elapsed / minDuration, 1);

      if (timeRatio < 0.86) {
        progress = Math.floor(timeRatio * 94);
      } else if (timeRatio >= 1 && (videoReady || elapsed > 5500)) {
        progress = 100;
      } else {
        progress = 95 + Math.floor((Math.sin(elapsed / 80) + 1) * 2);
      }

      if (statusEl) {
        if (progress < 25) {
          statusEl.textContent = "CONNECTING TO ARCHIVE...";
        } else if (progress < 60) {
          statusEl.textContent = "STREAMING HERO REEL...";
        } else if (progress < 90) {
          statusEl.textContent = "CACHING MEDIA LOCALLY...";
        } else if (progress < 100) {
          statusEl.textContent = "PREPARING CINEMA STAGE...";
        } else {
          statusEl.textContent = "READY";
        }
      }

      percent.textContent = `${progress}%`;

      if (progress >= 100) {
        percent.textContent = "100%";
        if (statusEl) statusEl.textContent = "READY";
        setTimeout(finishPreloader, 350);
      } else {
        preloaderRaf = requestAnimationFrame(updateProgress);
      }
    }

    preloaderRaf = requestAnimationFrame(updateProgress);

    function finishPreloader() {
      // 1. Fade out meta labels
      if (metaGroupEl) {
        metaGroupEl.style.transition = "opacity 0.3s ease";
        metaGroupEl.style.opacity = "0";
      }
      const topBar = preloader.querySelector<HTMLElement>(".preloader-top-bar");
      const bottomBar = preloader.querySelector<HTMLElement>(
        ".preloader-bottom-bar",
      );
      if (topBar) {
        topBar.style.transition = "opacity 0.3s ease";
        topBar.style.opacity = "0";
      }
      if (bottomBar) {
        bottomBar.style.transition = "opacity 0.3s ease";
        bottomBar.style.opacity = "0";
      }

      // 2. After brief pause, fly the logo to the navbar
      setTimeout(() => {
        flyLogoToNav();
      }, 320);
    }

    function flyLogoToNav() {
      // Measure current logo position
      const srcRect = logoWrapEl.getBoundingClientRect();

      const navLogoLink = document.querySelector<HTMLElement>(
        "#main-nav-header .logo-link",
      );

      if (!navLogoLink || !navLogoImg) {
        simpleFadeOut();
        return;
      }

      const tgtRect = navLogoLink.getBoundingClientRect();

      // Target size matches the rendered nav logo height
      const isMobile = window.innerWidth <= 768;
      const targetHeight = isMobile ? 60 : 76;
      const targetWidth = targetHeight; // logo is a square

      // Source and target centres
      const srcCx = srcRect.left + srcRect.width / 2;
      const srcCy = srcRect.top + srcRect.height / 2;
      const tgtCx = tgtRect.left + tgtRect.width / 2;
      const tgtCy = tgtRect.top + tgtRect.height / 2;

      // Create flying clone that floats above everything
      const clone = document.createElement("img");
      clone.src = "/images/logo.png";
      clone.alt = "";
      clone.setAttribute("aria-hidden", "true");
      clone.style.cssText = `
        position: fixed;
        z-index: 9999999;
        pointer-events: none;
        width: ${srcRect.width}px;
        height: ${srcRect.height}px;
        left: ${srcRect.left}px;
        top: ${srcRect.top}px;
        transform-origin: center center;
        will-change: transform, opacity;
        object-fit: contain;
      `;
      document.body.appendChild(clone);

      // Hide the in-preloader logo (clone takes visual ownership)
      logoWrapEl.style.opacity = "0";

      // Fade out the black overlay
      preloader.classList.add("fade-out");
      document.body.style.overflow = "";
      if (heroSection) heroSection.classList.add("is-ready");

      // Two rAF ticks ensure browser has painted the clone before animating
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const dx = tgtCx - srcCx;
          const dy = tgtCy - srcCy;
          const scaleX = targetWidth / srcRect.width;
          const scaleY = targetHeight / srcRect.height;

          clone.style.transition =
            "transform 0.72s cubic-bezier(0.76, 0, 0.24, 1), opacity 0.2s ease";
          clone.style.transform = `translate(${dx}px, ${dy}px) scale(${scaleX}, ${scaleY})`;

          // Swap clone → real nav logo just before landing
          setTimeout(() => {
            if (navLogoImg) {
              navLogoImg.style.transition = "opacity 0.18s ease";
              navLogoImg.style.opacity = "1";
            }
            clone.style.opacity = "0";
            setTimeout(() => clone.remove(), 200);
          }, 640);
        });
      });

      // Remove preloader DOM after overlay transition
      setTimeout(() => {
        preloader.style.display = "none";
      }, 900);
    }

    function simpleFadeOut() {
      preloader.classList.add("fade-out");
      document.body.style.overflow = "";
      if (heroSection) heroSection.classList.add("is-ready");
      if (navLogoImg) {
        navLogoImg.style.transition = "opacity 0.3s ease";
        navLogoImg.style.opacity = "1";
      }
      setTimeout(() => {
        preloader.style.display = "none";
      }, 900);
    }
  }

  RunPreloader();
  document.addEventListener("astro:page-load", RunPreloader);
</script>

<style>
  .preloader-screen {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: #000000;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-xl) var(--space-2xl);
    box-sizing: border-box;
    user-select: none;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .preloader-screen.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  /* Top & Bottom metadata rows */
  .preloader-top-bar,
  .preloader-bottom-bar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .meta-tag {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Center Content Stage */
  .preloader-center-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    margin: auto 0;
  }

  /* ---------- Logo Stage ---------- */
  .preloader-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 180px;
  }

  .preloader-logo {
    width: 140px;
    height: 140px;
    object-fit: contain;
    display: block;
    position: relative;
    z-index: 2;
    /* Subtle glow pulse while loading — no size change */
    animation: logo-glow 3s ease-in-out infinite;
    filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.28));
    will-change: filter;
  }

  @keyframes logo-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.28));
    }
    50% {
      filter: drop-shadow(0 0 38px rgba(255, 255, 255, 0.55));
    }
  }

  /* Percentage & Subtitle Status */
  .preloader-meta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .percentage-counter {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
  }

  .status-stage-text {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 768px) {
    .preloader-screen {
      padding: var(--space-lg);
    }
    .preloader-logo-wrap {
      width: 140px;
      height: 140px;
    }
    .preloader-logo {
      width: 110px;
      height: 110px;
    }
  }
</style>
