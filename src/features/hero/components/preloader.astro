    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: background-color 0.5s;
  }

  :global(#ld-bg) {
    position: absolute;
    inset: 0;
    display: none;
    background: var(--bg);
    will-change: opacity;
  }

  :global(#ld-cv) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
    will-change: opacity;
  }

  :global(#ld-vid) {
    position: absolute;
    width: 2px;
    height: 2px;
    opacity: 0;
    pointer-events: none;
  }

  :global(#ld) {
    --wb: clamp(230px, 21vw, 360px);
    position: relative;
    width: 100%;
    height: 100%;
  }

  :global(#ld-block) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: var(--wb);
    height: auto;
    display: none;
    fill: #e1e1d7;
    mix-blend-mode: difference;
  }

  :global(#ld-txt) {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + var(--wb) * 0.192 + 3.4rem);
    text-align: center;
    font-family: var(--mf);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    white-space: pre;
    transition: opacity 0.35s;
    color: #e1e1d7;
    text-shadow:
      0 0 12px rgba(0, 0, 0, 0.65),
      0 0 3px rgba(0, 0, 0, 0.7);
  }

  #fly {
    position: fixed;
    z-index: 120;
    pointer-events: none;
    mix-blend-mode: difference;
    will-change: transform;
  }

  #fly svg,
  .flyN svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  :global(.ldN) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: var(--wb);
    height: auto;
    display: none;
    pointer-events: none;
  }

  :global(#ldNA),
  #flyA {
    mix-blend-mode: multiply;
  }

  :global(#ldNB),
  #flyB {
    mix-blend-mode: screen;
  }

  .flyN {
    position: fixed;
    z-index: 121;
    pointer-events: none;
    will-change: transform;
  }
</style>
