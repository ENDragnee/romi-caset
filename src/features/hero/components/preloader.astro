---

---

<div id="preloader" class="preloader-screen" aria-hidden="false">
  {/* Top metadata bar (Reference 00:00) */}
  <div class="preloader-top-bar">
    <span class="meta-tag">ROMI</span>
    <span class="meta-tag">KASET PRODUCTION</span>
  </div>

  {/* Center Vertical Kinetic Drum Reel (Matches Reference 00:01 - 00:03) */}
  <div class="preloader-center-content">
    <div class="reel-window">
      <div id="reel-cylinder" class="reel-cylinder">
        {/* Frame 0: 'R' */}
        <div class="reel-cell">
          <span class="block-glyph">R</span>
        </div>

        {/* Frame 1: 'O' (Geometric block match) */}
        <div class="reel-cell">
          <span class="block-glyph">O</span>
        </div>

        {/* Frame 2: 'M' */}
        <div class="reel-cell">
          <span class="block-glyph">M</span>
        </div>

        {/* Frame 3: 'I' */}
        <div class="reel-cell">
          <span class="block-glyph">I</span>
        </div>
      </div>
    </div>

    {/* Percentage Counter & Subtitle Status */}
    <div class="preloader-meta-group">
      <div id="preloader-percentage" class="percentage-counter">0%</div>
      <div id="preloader-status-text" class="status-stage-text">
        CONNECTING TO ARCHIVE...
      </div>
    </div>
  </div>

  {/* Bottom metadata bar (Reference 00:00) */}
  <div class="preloader-bottom-bar">
    <span class="meta-tag">BORN RISK TAKERS</span>
    <span class="meta-tag">@ROMI</span>
  </div>
</div>

<script>
  let preloaderRaf: number | null = null;

  function RunPreloader() {
    const preloaderEl = document.querySelector<HTMLElement>("#preloader");
    const cylinderEl = document.querySelector<HTMLElement>("#reel-cylinder");
    const percentEl = document.querySelector<HTMLElement>(
      "#preloader-percentage",
    );
    const statusEl = document.querySelector<HTMLElement>(
      "#preloader-status-text",
    );
    const heroSection = document.querySelector<HTMLElement>("#hero-section");
    const video =
      document.querySelector<HTMLVideoElement>("#hero-video-a") ||
      document.querySelector<HTMLVideoElement>("#hero-video");

    if (!preloaderEl || !cylinderEl || !percentEl) return;

    const preloader = preloaderEl;
    const cylinder = cylinderEl;
    const percent = percentEl;

    if (preloaderRaf) {
      cancelAnimationFrame(preloaderRaf);
      preloaderRaf = null;
    }

    preloader.style.display = "flex";
    preloader.classList.remove("fade-out");
    percent.textContent = "0%";
    if (statusEl) statusEl.textContent = "CONNECTING TO ARCHIVE...";
    document.body.style.overflow = "hidden";

    // Frame height in pixels (120px on desktop, 90px on mobile)
    const isMobile = window.innerWidth <= 768;
    const frameHeight = isMobile ? 90 : 120;

    cylinder.style.transform = "translateY(0px)";

    let progress = 0;
    let videoReady = false;

    if (video) {
      if (video.readyState >= 2 || video.currentTime > 0) {
        videoReady = true;
      } else {
        const markReady = () => {
          videoReady = true;
        };
        video.addEventListener("canplay", markReady, { once: true });
        video.addEventListener("playing", markReady, { once: true });
        video.addEventListener("loadeddata", markReady, { once: true });
      }
    } else {
      videoReady = true;
    }

    const startTime = performance.now();
    const minDuration = 5000; // 5-second buffer

    // Steps: 0 = 'R', 1 = 'O', 2 = 'M', 3 = 'I'
    function getReelStep(pct: number): number {
      if (pct < 28) return 0; // 'R' (0% - 28%)
      if (pct < 62) return 1; // 'O' (28% - 62%)
      if (pct < 88) return 2; // 'M' (62% - 88%)
      return 3; // 'I' (88% - 100%)
    }

    let currentStep = 0;

    function updateProgress(now: number) {
      const elapsed = now - startTime;
      const timeRatio = Math.min(elapsed / minDuration, 1);

      if (timeRatio < 0.86) {
        progress = Math.floor(timeRatio * 94);
      } else if (timeRatio >= 1 && (videoReady || elapsed > 5500)) {
        progress = 100;
      } else {
        progress = 95 + Math.floor((Math.sin(elapsed / 80) + 1) * 2);
      }

      // Vertical Drum Roll Transition (Reference 00:02)
      const targetStep = getReelStep(progress);
      if (targetStep !== currentStep) {
        currentStep = targetStep;
        cylinder.style.transform = `translateY(-${currentStep * frameHeight}px)`;
      }

      if (statusEl) {
        if (progress < 25) {
          statusEl.textContent = "CONNECTING TO ARCHIVE...";
        } else if (progress < 60) {
          statusEl.textContent = "STREAMING HERO REEL...";
        } else if (progress < 90) {
          statusEl.textContent = "CACHING MEDIA LOCALLY...";
        } else if (progress < 100) {
          statusEl.textContent = "PREPARING CINEMA STAGE...";
        } else {
          statusEl.textContent = "READY";
        }
      }

      percent.textContent = `${progress}%`;

      if (progress >= 100) {
        percent.textContent = "100%";
        if (statusEl) statusEl.textContent = "READY";
        setTimeout(finishPreloader, 350);
      } else {
        preloaderRaf = requestAnimationFrame(updateProgress);
      }
    }

    preloaderRaf = requestAnimationFrame(updateProgress);

    function finishPreloader() {
      preloader.classList.add("fade-out");
      document.body.style.overflow = "";

      if (heroSection) {
        heroSection.classList.add("is-ready");
      }

      setTimeout(() => {
        preloader.style.display = "none";
      }, 700);
    }
  }

  RunPreloader();
  document.addEventListener("astro:page-load", RunPreloader);
</script>

<style>
  .preloader-screen {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: #000000;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-xl) var(--space-2xl);
    box-sizing: border-box;
    user-select: none;
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .preloader-screen.fade-out {
    opacity: 0;
    transform: translateY(-40px);
    pointer-events: none;
  }

  /* Top & Bottom metadata rows (Reference 00:00) */
  .preloader-top-bar,
  .preloader-bottom-bar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .meta-tag {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Center Content Stage */
  .preloader-center-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    margin: auto 0;
  }

  /* ---------- Vertical Drum Slot Viewport (Reference 00:02) ---------- */
  .reel-window {
    width: 160px;
    height: 120px; /* Fixed frame aperture */
    overflow: hidden;
    position: relative;
    display: flex;
    justify-content: center;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 15%,
      black 85%,
      transparent 100%
    );
  }

  .reel-cylinder {
    display: flex;
    flex-direction: column;
    width: 100%;
    /* Snappy kinetic roll matching reference 00:02 */
    transition: transform 0.45s cubic-bezier(0.85, 0, 0.15, 1);
    will-change: transform;
  }

  .reel-cell {
    width: 100%;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Ultra-Heavy Block Typography (Consistent Across All Glyphs) */
  .block-glyph {
    font-family: "Space Grotesk", Impact, "Arial Black", sans-serif;
    font-size: clamp(5.5rem, 14vw, 7.5rem);
    font-weight: 900;
    line-height: 1;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    text-shadow: 0 0 35px rgba(255, 255, 255, 0.45);
    display: block;
    user-select: none;
    text-align: center;
  }

  /* Percentage & Subtitle Status */
  .preloader-meta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .percentage-counter {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
  }

  .status-stage-text {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 768px) {
    .preloader-screen {
      padding: var(--space-lg);
    }
    .reel-window {
      width: 120px;
      height: 90px;
    }
    .reel-cell {
      height: 90px;
    }
    .block-glyph {
      font-size: 4.8rem;
    }
  }
</style>
