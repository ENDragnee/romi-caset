---
import { navigation } from "../../../lib/mock-data";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<header
  class={`nav-header ${transparent ? "transparent" : ""}`}
  id="main-nav-header"
>
  <div class="container container--wide nav-container">
    {/* Left: Brand Logo */}
    <a href="/" class="logo-link" aria-label="Kaset Production Home">
      <img src="/images/logo.png" alt="KASET PRODUCTION" class="logo-img" />
    </a>

    {/* Right: Desktop Navigation + Mobile Menu Toggle */}
    <div class="nav-right-group">
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {
            navigation.map((item) => (
              <li class="nav-item">
                <a href={item.href} class="nav-link">
                  <span>{item.label}</span>
                  {item.children && <span class="nav-chevron">▾</span>}
                </a>
                {item.children && (
                  <ul class="dropdown">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="dropdown-link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="nav-actions">
        <button
          id="mobile-menu-toggle"
          class="mobile-toggle"
          type="button"
          aria-label="Open menu"
        >
          <span class="hamburger"></span>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Menu Drawer */}
  <div id="mobile-menu" class="mobile-menu">
    {/* Top Header: Logo on Left + Close on Right */}
    <div class="mobile-menu-header">
      <a href="/" class="logo-link" aria-label="Kaset Production Home">
        <img src="/images/logo.png" alt="KASET" class="logo-img-mobile" />
      </a>
      <button
        id="mobile-menu-close"
        class="mobile-close"
        type="button"
        aria-label="Close menu">&times;</button
      >
    </div>

    {/* Centered Navigation Body */}
    <div class="mobile-menu-body">
      <nav class="mobile-nav">
        <ul class="mobile-nav-list">
          {
            navigation.map((item) => (
              <li
                class={`mobile-nav-item ${item.children ? "has-children" : ""}`}
              >
                <div class="mobile-nav-row">
                  <a
                    href={item.children ? "javascript:void(0)" : item.href}
                    class="mobile-nav-link"
                  >
                    <span>{item.label}</span>
                    {item.children && <span class="mobile-chevron">▾</span>}
                  </a>
                </div>
                {item.children && (
                  <ul class="mobile-dropdown">
                    {item.children.map((child) => (
                      <li class="mobile-dropdown-item">
                        <a href={child.href} class="mobile-dropdown-link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* Bottom Copyright Tag */}
    <div class="mobile-menu-footer">
      <span class="mobile-copy">&copy; {currentYear} KASET PRODUCTION</span>
    </div>
  </div>
</header>

<script>
  let currentPath;
  function InitNavbar() {
    const header = document.querySelector<HTMLElement>("#main-nav-header");

    if (header) {
      const handleScroll = () => {
        currentPath = window.location.pathname;
        if (window.scrollY > 920 && currentPath === "/") {
          header.classList.add("scrolled");
        } else if (currentPath !== "/") {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      };
      window.addEventListener("scroll", handleScroll, { passive: true });
      handleScroll();
    }

    // Intercept dropdown clicks when already on /portfolio for instant smooth filtering
    document
      .querySelectorAll<HTMLAnchorElement>(
        ".dropdown-link, .mobile-dropdown-link",
      )
      .forEach((link) => {
        link.onclick = (e) => {
          const href = link.getAttribute("href") || "";
          const url = new URL(href, window.location.origin);

          if (
            window.location.pathname === "/portfolio" &&
            url.pathname === "/portfolio"
          ) {
            e.preventDefault();
            const category = url.searchParams.get("category") || "ALL";
            window.dispatchEvent(
              new CustomEvent("apply-portfolio-filter", {
                detail: { category },
              }),
            );
            window.history.replaceState({}, "", href);
          }
        };
      });

    const mobileMenuToggle = document.querySelector<HTMLButtonElement>(
      "#mobile-menu-toggle",
    );
    const mobileMenuClose =
      document.querySelector<HTMLButtonElement>("#mobile-menu-close");
    const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");

    if (mobileMenuToggle && mobileMenuClose && mobileMenu) {
      const openMenu = () => {
        mobileMenu.classList.add("open");
        document.body.style.overflow = "hidden";
      };

      const closeMenu = () => {
        mobileMenu.classList.remove("open");
        document.body.style.overflow = "";
      };

      mobileMenuToggle.onclick = openMenu;
      mobileMenuClose.onclick = closeMenu;

      const mobileNavItems =
        mobileMenu.querySelectorAll<HTMLElement>(".mobile-nav-item");

      mobileNavItems.forEach((item) => {
        const hasChildren = item.classList.contains("has-children");
        const row = item.querySelector<HTMLElement>(".mobile-nav-row");
        const link = item.querySelector<HTMLAnchorElement>("a.mobile-nav-link");

        if (hasChildren && row) {
          row.onclick = (e: MouseEvent) => {
            e.preventDefault();
            e.stopPropagation();
            item.classList.toggle("expanded");
          };
        } else if (link) {
          link.onclick = () => closeMenu();
        }

        item
          .querySelectorAll<HTMLAnchorElement>(".mobile-dropdown-link")
          .forEach((subLink) => {
            subLink.addEventListener("click", () => closeMenu());
          });
      });
    }
  }

  InitNavbar();
  document.addEventListener("astro:page-load", InitNavbar);
</script>

<style>
  /* ---------- Header Container ---------- */
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-height);
    z-index: 1000;
    transition:
      background-color var(--transition-normal),
      border-color var(--transition-normal),
      backdrop-filter var(--transition-normal);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-header.transparent {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  .nav-header.transparent .nav-link,
  .nav-header.transparent .mobile-toggle {
    color: #ffffff !important;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.7);
  }

  .nav-header.transparent .nav-link:hover {
    color: rgba(255, 255, 255, 0.75) !important;
  }

  .nav-header.scrolled {
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 0px solid var(--color-border);
  }

  .nav-header.scrolled .nav-link,
  .nav-header.scrolled .mobile-toggle {
    color: #000000 !important;
    text-shadow: none;
  }

  .nav-header.scrolled .nav-link:hover {
    color: rgba(0, 0, 0, 0.6) !important;
  }

  .nav-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-xl);
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    z-index: 2;
  }

  .logo-img {
    height: 72px;
    width: auto;
    display: block;
    transition: transform var(--transition-fast);
  }

  .logo-img:hover {
    transform: scale(1.02);
  }

  /* ---------- Desktop Navigation ---------- */
  .nav-right-group {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
    margin-left: auto;
    z-index: 2;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
    padding-block: var(--space-xs);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: var(--space-2xs) 0;
    transition: color var(--transition-fast);
  }

  .nav-chevron {
    font-size: 0.7rem;
    transition: transform var(--transition-fast);
  }

  .nav-item:hover .nav-chevron {
    transform: rotate(180deg);
  }

  /* Desktop Dropdown */
  .dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    list-style: none;
    padding: var(--space-xs);
    margin: 0;
    min-width: 180px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      visibility var(--transition-fast);
  }

  .nav-item:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: var(--space-xs) var(--space-md);
    color: #000000 !important;
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-heading);
    letter-spacing: 0.05em;
    text-shadow: none !important;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .dropdown-link:hover {
    background-color: #f5f5f5;
    color: #666666 !important;
  }

  /* ---------- Mobile Toggle & Drawer ---------- */
  .nav-actions {
    display: flex;
    align-items: center;
  }

  .mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger {
    display: block;
    width: 22px;
    height: 2px;
    background-color: currentColor;
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    width: 22px;
    height: 2px;
    background-color: currentColor;
    left: 0;
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    bottom: -6px;
  }

  /* ==========================================================================
     Mobile Menu (Drawer with Top Logo & Close Button)
     ========================================================================== */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: #ffffff;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xl) var(--space-xl) var(--space-2xl);
    visibility: hidden;
    transform: translateX(100%);
    transition:
      transform 0.45s cubic-bezier(0.25, 1, 0.5, 1),
      visibility 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    overflow-y: auto;
    box-sizing: border-box;
    will-change: transform;
  }

  .mobile-menu.open {
    visibility: visible;
    transform: translateX(0);
  }

  /* Top Drawer Header with Logo & Close Button */
  .mobile-menu-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-img-mobile {
    height: 64px;
    width: auto;
    display: block;
  }

  .mobile-close {
    background: none;
    border: none;
    font-size: 2.5rem;
    line-height: 1;
    color: #000000;
    cursor: pointer;
    padding: 0;
    transition: opacity var(--transition-fast);
  }

  .mobile-close:hover {
    opacity: 0.6;
  }

  /* Centered Navigation Body */
  .mobile-menu-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: auto 0;
  }

  .mobile-nav {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    width: 100%;
    text-align: center;
  }

  .mobile-nav-item {
    border: none !important;
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mobile-nav-row {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 6vw, 1.9rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #000000;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity var(--transition-fast);
  }

  .mobile-nav-link:hover {
    opacity: 0.6;
  }

  .mobile-chevron {
    font-size: 0.9rem;
    transition: transform var(--transition-fast);
  }

  .mobile-nav-item.expanded .mobile-chevron {
    transform: rotate(180deg);
  }

  /* Centered Submenu */
  .mobile-dropdown {
    list-style: none;
    padding: var(--space-md) 0 0 0;
    margin: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
  }

  .mobile-nav-item.expanded .mobile-dropdown {
    display: flex;
  }

  .mobile-dropdown-item {
    padding: var(--space-2xs) 0;
  }

  .mobile-dropdown-link {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #777777;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .mobile-dropdown-link:hover {
    color: #000000;
  }

  /* Bottom Copyright */
  .mobile-menu-footer {
    width: 100%;
    text-align: center;
    padding-top: var(--space-lg);
  }

  .mobile-copy {
    font-family: var(--font-heading);
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888888;
  }

  @media (max-width: 768px) {
    .logo-img {
      height: 64px;
    }
    .mobile-nav-list {
      gap: var(--space-xl);
    }
  }
</style>
