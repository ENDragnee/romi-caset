---
import { navigation } from "../../../lib/mock-data";

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header class={`nav-header ${transparent ? "transparent" : ""}`}>
  <div class="container container--wide nav-container">
    {/* Left: Brand Logo */}
    <a href="/" class="logo-link" aria-label="Kaset Production Home">
      <img src="/images/logo.png" alt="KASET PRODUCTION" class="logo-img" />
    </a>

    {/* Right: Desktop Navigation + Actions */}
    <div class="nav-right-group">
      <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          {
            navigation.map((item) => (
              <li class="nav-item">
                <a href={item.href} class="nav-link">
                  <span>{item.label}</span>
                  {item.children && <span class="nav-chevron">▾</span>}
                </a>
                {item.children && (
                  <ul class="dropdown">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="dropdown-link">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="nav-actions">
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Toggle theme"
        >
          <svg
            class="sun-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            class="moon-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <button
          id="mobile-menu-toggle"
          class="mobile-toggle"
          type="button"
          aria-label="Open menu"
        >
          <span class="hamburger"></span>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Menu Drawer */}
  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu-header">
      <img src="/images/logo.png" alt="KASET" class="logo-img-mobile" />
      <button
        id="mobile-menu-close"
        class="mobile-close"
        type="button"
        aria-label="Close menu">&times;</button
      >
    </div>

    <nav class="mobile-nav">
      <ul class="mobile-nav-list">
        {
          navigation.map((item) => (
            <li
              class={`mobile-nav-item ${item.children ? "has-children" : ""}`}
            >
              <div class="mobile-nav-row">
                <a href={item.href} class="mobile-nav-link">
                  {item.label}
                </a>
                {item.children && (
                  <button
                    type="button"
                    class="mobile-expand-btn"
                    aria-label={`Toggle ${item.label} submenu`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </button>
                )}
              </div>
              {item.children && (
                <ul class="mobile-dropdown">
                  {item.children.map((child) => (
                    <li class="mobile-dropdown-item">
                      <a href={child.href} class="mobile-dropdown-link">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function InitNavbar() {
    const header = document.querySelector<HTMLElement>(".nav-header");

    if (header) {
      const handleScroll = () => {
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      };
      window.addEventListener("scroll", handleScroll);
      handleScroll();
    }

    const themeToggle =
      document.querySelector<HTMLButtonElement>("#theme-toggle");
    if (themeToggle) {
      themeToggle.onclick = (e: MouseEvent) => {
        e.preventDefault();
        const currentTheme =
          document.documentElement.getAttribute("data-theme") || "dark";
        const newTheme = currentTheme === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("kaset-theme", newTheme);
      };
    }

    const mobileMenuToggle = document.querySelector<HTMLButtonElement>(
      "#mobile-menu-toggle",
    );
    const mobileMenuClose =
      document.querySelector<HTMLButtonElement>("#mobile-menu-close");
    const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");

    if (mobileMenuToggle && mobileMenuClose && mobileMenu) {
      const openMenu = () => {
        mobileMenu.classList.add("open");
        document.body.style.overflow = "hidden";
      };

      const closeMenu = () => {
        mobileMenu.classList.remove("open");
        document.body.style.overflow = "";
      };

      mobileMenuToggle.onclick = openMenu;
      mobileMenuClose.onclick = closeMenu;

      mobileMenu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
        link.onclick = closeMenu;
      });

      mobileMenu
        .querySelectorAll<HTMLButtonElement>(".mobile-expand-btn")
        .forEach((btn) => {
          btn.onclick = (e: MouseEvent) => {
            e.stopPropagation();
            const parentItem = (e.currentTarget as HTMLElement).closest(
              ".mobile-nav-item",
            );
            parentItem?.classList.toggle("expanded");
          };
        });
    }
  }

  InitNavbar();
  document.addEventListener("astro:page-load", InitNavbar);
</script>

<style>
  /* ---------- Header Container ---------- */
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-height);
    z-index: 1000;
    transition:
      background-color var(--transition-normal),
      backdrop-filter var(--transition-normal),
      border-color var(--transition-normal);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-header.transparent {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  .nav-header.transparent .nav-link,
  .nav-header.transparent .theme-toggle,
  .nav-header.transparent .mobile-toggle {
    color: white;
  }

  .nav-header.scrolled {
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-header.scrolled .nav-link,
  .nav-header.scrolled .theme-toggle,
  .nav-header.scrolled .mobile-toggle {
    color: var(--color-text);
  }

  .nav-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 38px;
    width: auto;
    display: block;
  }

  /* ---------- Right Group (Nav + Actions) ---------- */
  .nav-right-group {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    margin-left: auto;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
    padding-block: var(--space-xs);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: var(--space-2xs) 0;
    transition: color var(--transition-fast);
  }

  .nav-chevron {
    font-size: 0.7rem;
    transition: transform var(--transition-fast);
  }

  .nav-item:hover .nav-chevron {
    transform: rotate(180deg);
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  /* Desktop Dropdown */
  .dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    list-style: none;
    padding: var(--space-xs);
    margin: 0;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      visibility var(--transition-fast);
    backdrop-filter: blur(8px);
  }

  .nav-item:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: var(--space-xs) var(--space-md);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-heading);
    letter-spacing: 0.05em;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .dropdown-link:hover {
    background-color: var(--color-surface-elevated);
    color: var(--color-accent);
  }

  /* ---------- Nav Actions & Fixed Theme Switcher ---------- */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text);
    cursor: pointer;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    overflow: hidden;
    transition: all var(--transition-fast);
  }

  .theme-toggle:hover {
    background-color: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-accent);
  }

  /* Absolute centered icons prevent crooked/offset icon rendering */
  .theme-toggle svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 18px;
    height: 18px;
  }

  /* Default theme styling */
  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }

  /* Dark mode */
  :global([data-theme="dark"]) .sun-icon {
    display: block !important;
  }
  :global([data-theme="dark"]) .moon-icon {
    display: none !important;
  }

  /* Light mode */
  :global([data-theme="light"]) .sun-icon {
    display: none !important;
  }
  :global([data-theme="light"]) .moon-icon {
    display: block !important;
  }

  .mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger {
    display: block;
    width: 22px;
    height: 2px;
    background-color: currentColor;
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: "";
    position: absolute;
    width: 22px;
    height: 2px;
    background-color: currentColor;
    left: 0;
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    bottom: -6px;
  }

  /* ---------- Mobile Menu Overlay ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    background-color: var(--color-bg);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    padding: var(--space-xl) var(--space-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal),
      visibility var(--transition-normal);
    overflow-y: auto;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3xl);
  }

  .logo-img-mobile {
    height: 32px;
    width: auto;
  }

  .mobile-close {
    background: none;
    border: none;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--color-text);
    cursor: pointer;
    padding: var(--space-2xs);
  }

  .mobile-close:hover {
    color: var(--color-accent);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .mobile-nav-item {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-md);
  }

  .mobile-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
  }

  .mobile-expand-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .mobile-nav-item.expanded .mobile-expand-btn svg {
    transform: rotate(180deg);
  }

  .mobile-dropdown {
    list-style: none;
    padding: var(--space-sm) 0 0 var(--space-md);
    margin: 0;
    display: none;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mobile-nav-item.expanded .mobile-dropdown {
    display: flex;
  }

  .mobile-dropdown-link {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    text-decoration: none;
  }
</style>
