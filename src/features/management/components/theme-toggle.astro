---
// Icon button that flips the management theme between light and dark.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={["theme-toggle", className]}
  aria-label="Switch theme"
  title="Switch theme"
>
  <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
    <circle
      cx="8"
      cy="8"
      r="6.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"></circle>
    <path d="M8 1.4a6.6 6.6 0 0 1 0 13.2z" fill="currentColor"></path>
  </svg>
</button>

<script>
  import {
    applyTheme,
    resolvedTheme,
    setThemePref,
    watchSystemTheme,
  } from "@/lib/mgmt-theme";

  watchSystemTheme();
  applyTheme();

  const label = () =>
    resolvedTheme() === "dark"
      ? "Switch to light theme"
      : "Switch to dark theme";

  const sync = () =>
    document.querySelectorAll<HTMLElement>(".theme-toggle").forEach((b) => {
      b.setAttribute("aria-label", label());
      b.title = label();
    });

  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".theme-toggle")) return;
    setThemePref(resolvedTheme() === "dark" ? "light" : "dark");
  });
  document.addEventListener("mgmt-theme-change", sync);
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition:
      transform 0.6s cubic-bezier(0.77, 0, 0.18, 1),
      border-color var(--transition-fast);
  }

  .theme-toggle:hover {
    transform: rotate(180deg);
    border-color: var(--color-text);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
