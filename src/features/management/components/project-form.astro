---
import MediaPickerModal from "./media-picker-modal.astro";

interface Props {
  project?: {
    id: string;
    title: string;
    slug: string;
    client: string | null;
    category: string;
    cardType: string;
    year: number | null;
    youtubeUrl: string | null;
    description: string | null;
    featured: boolean;
    thumbnail: string | null;
    gallery: string[];
  };
  mode: "create" | "edit";
}

const { project, mode } = Astro.props;
const isEdit = mode === "edit";
---

<div class="form-card">
  <form id="project-form">
    {isEdit && <input type="hidden" id="project-id" value={project?.id} />}

    <div class="form-sections-wrapper">
      {/* Information Section */}
      <div class="form-section">
        <h3 class="section-heading">Project Information</h3>
        <div class="form-grid">
          <div class="form-group">
            <label for="title-input"
              >Project Title <span class="required">*</span></label
            >
            <input
              type="text"
              id="title-input"
              name="title"
              required
              value={project?.title || ""}
              placeholder="e.g. Neon Horizon"
            />
          </div>

          <div class="form-group">
            <label for="slug-input"
              >URL Slug <span class="required">*</span></label
            >
            <input
              type="text"
              id="slug-input"
              name="slug"
              required
              value={project?.slug || ""}
              placeholder="e.g. neon-horizon"
            />
          </div>

          <div class="form-group">
            <label for="client-input">Client Name</label>
            <input
              type="text"
              id="client-input"
              name="client"
              value={project?.client || ""}
              placeholder="e.g. Universal Music / Nike"
            />
          </div>

          <div class="form-group">
            <label for="category-input"
              >Category <span class="required">*</span></label
            >
            <select id="category-input" name="category" required>
              <option
                value="MUSICVIDEO"
                selected={project?.category === "MUSICVIDEO"}
                >Music Video</option
              >
              <option
                value="COMMERCIAL"
                selected={project?.category === "COMMERCIAL"}>Commercial</option
              >
              <option value="FILM" selected={project?.category === "FILM"}
                >Film</option
              >
            </select>
          </div>

          <div class="form-group">
            <label>Card Aspect Ratio <span class="required">*</span></label>
            <div class="radio-pill-group">
              <label class="radio-pill">
                <input
                  type="radio"
                  name="cardType"
                  value="WIDE"
                  checked={!project || project.cardType === "WIDE"}
                />
                <span>Wide (4:3)</span>
              </label>
              <label class="radio-pill">
                <input
                  type="radio"
                  name="cardType"
                  value="SQUARE"
                  checked={project?.cardType === "SQUARE"}
                />
                <span>Square (1:1)</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label for="year-input">Production Year</label>
            <input
              type="number"
              id="year-input"
              name="year"
              value={project?.year || ""}
              placeholder="2025"
            />
          </div>

          <div class="form-group full-width">
            <label for="youtube-input">YouTube / Video Embed URL</label>
            <input
              type="url"
              id="youtube-input"
              name="youtubeUrl"
              value={project?.youtubeUrl || ""}
              placeholder="https://www.youtube.com/watch?v=..."
            />
          </div>

          <div class="form-group full-width">
            <label for="description-input"
              >Project Synopsis / Director Notes</label
            >
            <textarea
              id="description-input"
              name="description"
              rows="4"
              placeholder="Project synopsis, creative direction, cinematography equipment notes, and credits..."
              >{project?.description || ""}</textarea
            >
          </div>

          <div class="form-group full-width">
            <label class="checkbox-pill">
              <input
                type="checkbox"
                name="featured"
                checked={project?.featured || false}
              />
              <span class="checkbox-label-text">
                <strong>Featured Project</strong>
                <small
                  >Showcase this project in the curated home reel and spotlight
                  section.</small
                >
              </span>
            </label>
          </div>
        </div>
      </div>

      {/* Visuals Section */}
      <div class="form-section">
        <h3 class="section-heading">Media Assets</h3>

        {/* Cover Thumbnail Slot */}
        <div class="media-field-block">
          <div class="field-title-group">
            <label class="field-label"
              >Primary Cover Thumbnail <span class="required">*</span></label
            >
            <span class="field-subtext"
              >Displayed across portfolio grids, category filters, and
              showreels.</span
            >
          </div>

          <input
            type="hidden"
            id="thumbnail-key"
            name="thumbnailKey"
            value={project?.thumbnail || ""}
          />
          <div id="thumbnail-container" class="thumbnail-slot-wrapper">
            {/* Populated State */}
            <div
              id="thumbnail-filled"
              class={`thumbnail-chosen-container ${project?.thumbnail ? "" : "hidden"}`}
            >
              <img
                id="thumbnail-img-preview"
                src={project?.thumbnail
                  ? `/api/media/${project.thumbnail}`
                  : ""}
                alt={project?.title || "Thumbnail preview"}
                loading="lazy"
              />
              <div class="thumbnail-hover-actions">
                <button
                  type="button"
                  id="change-thumbnail-btn"
                  class="btn-action-pill"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                    ></path><path
                      d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                    ></path></svg
                  >
                  <span>Change</span>
                </button>
                <button
                  type="button"
                  id="remove-thumbnail-btn"
                  class="btn-action-pill btn-action-danger"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><polyline points="3 6 5 6 21 6"></polyline><path
                      d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                    ></path></svg
                  >
                  <span>Remove</span>
                </button>
              </div>
            </div>

            {/* Empty State */}
            <div
              id="thumbnail-empty"
              class={`media-drop-preview ${project?.thumbnail ? "hidden" : ""}`}
            >
              <div class="empty-upload-prompt">
                <div class="prompt-icon-circle">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                </div>
                <div class="prompt-text-group">
                  <span class="prompt-primary">No cover thumbnail selected</span
                  >
                  <span class="prompt-secondary"
                    >Recommended ratio: 16:10 or 4:3 high-resolution landscape
                    still</span
                  >
                </div>
                <button
                  type="button"
                  id="choose-thumbnail-btn"
                  class="btn-secondary btn-sm"
                >
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><rect x="3" y="3" width="18" height="18" rx="2"
                    ></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline
                      points="21 15 16 10 5 21"></polyline></svg
                  >
                  <span>Choose from Library</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        {/* Gallery Multi-Asset Picker */}
        <div class="media-field-block">
          <div class="gallery-header-row">
            <div class="field-title-group">
              <label class="field-label">Behind The Scenes Stills</label>
              <span class="field-subtext"
                >Curate on-set photography and production archives for this
                project.</span
              >
            </div>
            <button
              type="button"
              id="manage-gallery-btn"
              class="btn-secondary btn-sm"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><line x1="12" y1="5" x2="12" y2="19"></line><line
                  x1="5"
                  y1="12"
                  x2="19"
                  y2="12"></line></svg
              >
              <span>Manage Stills</span>
            </button>
          </div>
          <input
            type="hidden"
            id="gallery-keys"
            name="galleryKeys"
            value={JSON.stringify(project?.gallery || [])}
          />
          <div id="gallery-items" class="gallery-grid-preview"></div>
        </div>
      </div>
    </div>

    {/* Form Actions Footer */}
    <div class="form-actions-bar">
      <div id="form-error" class="error-inline"></div>
      <div class="actions-right">
        <a href="/management/projects" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary" id="submit-btn">
          <span>{isEdit ? "Save Changes" : "Create Project"}</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </form>
</div>

{/* Media Picker Modal */}
<MediaPickerModal />

<script>
  // Auto-generate slug (Only on create)
  const titleInput = document.querySelector<HTMLInputElement>("#title-input");
  const slugInput = document.querySelector<HTMLInputElement>("#slug-input");
  const projectIdInput =
    document.querySelector<HTMLInputElement>("#project-id");
  const isEditMode = !!projectIdInput?.value;

  if (titleInput && slugInput && !isEditMode) {
    titleInput.addEventListener("input", () => {
      slugInput.value = titleInput.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");
    });
  }

  // Form Submission
  const form = document.querySelector<HTMLFormElement>("#project-form");
  const submitBtn = document.querySelector<HTMLButtonElement>("#submit-btn");
  const errorEl = document.querySelector<HTMLElement>("#form-error");

  if (form && submitBtn && errorEl) {
    form.addEventListener("submit", async (e: SubmitEvent) => {
      e.preventDefault();
      errorEl.textContent = "";
      submitBtn.textContent = isEditMode ? "Saving..." : "Creating...";
      submitBtn.disabled = true;

      const formData = new FormData(form);
      const data = {
        title: formData.get("title"),
        slug: formData.get("slug"),
        client: formData.get("client") || null,
        category: formData.get("category"),
        cardType: formData.get("cardType"),
        year: formData.get("year")
          ? parseInt(formData.get("year") as string)
          : null,
        youtubeUrl: formData.get("youtubeUrl") || null,
        description: formData.get("description") || null,
        featured: formData.get("featured") === "on",
        thumbnailKey: formData.get("thumbnailKey") || null,
        galleryKeys: JSON.parse(
          (formData.get("galleryKeys") as string) || "[]",
        ),
      };

      const endpoint = isEditMode
        ? `/api/management/projects/${projectIdInput?.value}`
        : "/api/management/projects";

      const method = isEditMode ? "PUT" : "POST";

      try {
        const res = await fetch(endpoint, {
          method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          window.location.href = "/management/projects";
        } else {
          const errData = await res.json();
          errorEl.textContent = errData.message || "Error saving project";
          submitBtn.textContent = isEditMode
            ? "Save Changes"
            : "Create Project";
          submitBtn.disabled = false;
        }
      } catch {
        errorEl.textContent = "Network error. Try again.";
        submitBtn.textContent = isEditMode ? "Save Changes" : "Create Project";
        submitBtn.disabled = false;
      }
    });
  }

  // --- Thumbnail & Gallery UI Handlers ---
  const thumbnailKeyInput =
    document.querySelector<HTMLInputElement>("#thumbnail-key");
  const thumbnailFilled =
    document.querySelector<HTMLElement>("#thumbnail-filled");
  const thumbnailEmpty =
    document.querySelector<HTMLElement>("#thumbnail-empty");
  const thumbnailImg = document.querySelector<HTMLImageElement>(
    "#thumbnail-img-preview",
  );
  const chooseThumbnailBtn = document.querySelector<HTMLButtonElement>(
    "#choose-thumbnail-btn",
  );
  const changeThumbnailBtn = document.querySelector<HTMLButtonElement>(
    "#change-thumbnail-btn",
  );
  const removeThumbnailBtn = document.querySelector<HTMLButtonElement>(
    "#remove-thumbnail-btn",
  );

  const galleryKeysInput =
    document.querySelector<HTMLInputElement>("#gallery-keys");
  const manageGalleryBtn = document.querySelector<HTMLButtonElement>(
    "#manage-gallery-btn",
  );
  const galleryGrid = document.querySelector<HTMLElement>("#gallery-items");

  renderGalleryPreview();

  const openThumbnailPicker = () => {
    window.dispatchEvent(
      new CustomEvent("open-media-picker", {
        detail: {
          target: "thumbnail",
          multiple: false,
          preselectedKeys: thumbnailKeyInput?.value || null,
        },
      }),
    );
  };

  chooseThumbnailBtn?.addEventListener("click", openThumbnailPicker);
  changeThumbnailBtn?.addEventListener("click", openThumbnailPicker);

  removeThumbnailBtn?.addEventListener("click", () => {
    if (thumbnailKeyInput) thumbnailKeyInput.value = "";
    if (thumbnailImg) thumbnailImg.src = "";
    thumbnailFilled?.classList.add("hidden");
    thumbnailEmpty?.classList.remove("hidden");
  });

  manageGalleryBtn?.addEventListener("click", () => {
    const keys: string[] = JSON.parse(galleryKeysInput?.value || "[]");
    window.dispatchEvent(
      new CustomEvent("open-media-picker", {
        detail: {
          target: "gallery",
          multiple: true,
          preselectedKeys: keys,
        },
      }),
    );
  });

  window.addEventListener("media-picker-selected", (e: any) => {
    const { target, keys, items } = e.detail || {};

    if (target === "thumbnail" && items && items.length > 0) {
      const selectedItem = items[0];
      if (thumbnailKeyInput) thumbnailKeyInput.value = selectedItem.key;
      if (thumbnailImg) thumbnailImg.src = `/api/media/${selectedItem.key}`;
      thumbnailEmpty?.classList.add("hidden");
      thumbnailFilled?.classList.remove("hidden");
    } else if (target === "gallery" && keys) {
      if (galleryKeysInput) galleryKeysInput.value = JSON.stringify(keys);
      renderGalleryPreview();
    }
  });

  function renderGalleryPreview() {
    if (!galleryGrid || !galleryKeysInput) return;
    const keys: string[] = JSON.parse(galleryKeysInput.value || "[]");

    if (keys.length === 0) {
      galleryGrid.innerHTML = `
        <div class="gallery-empty-msg">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
      `;
      return;
    }

    galleryGrid.innerHTML = keys
      .map(
        (key: string) => `
      <div class="gallery-item-card" data-key="${key}">
        <img src="/api/media/${key}" alt="Production still" loading="lazy" />
        <button type="button" class="remove-gallery-item-btn" data-key="${key}" title="Remove still">&times;</button>
      </div>
    `,
      )
      .join("");

    galleryGrid
      .querySelectorAll<HTMLButtonElement>(".remove-gallery-item-btn")
      .forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const keyToRemove = btn.dataset.key;
          const currentKeys: string[] = JSON.parse(
            galleryKeysInput.value || "[]",
          );
          galleryKeysInput.value = JSON.stringify(
            currentKeys.filter((k: string) => k !== keyToRemove),
          );
          renderGalleryPreview();
        });
      });
  }
</script>

<style>
  .form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .form-sections-wrapper {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .section-heading {
    font-size: 1.1rem;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg) var(--space-xl);
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .field-title-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .form-group label,
  .field-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .field-subtext {
    font-size: 0.775rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .required {
    color: var(--color-accent);
  }

  .form-group input[type="text"],
  .form-group input[type="number"],
  .form-group input[type="url"],
  .form-group select,
  .form-group textarea {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.95rem;
    width: 100%;
    box-sizing: border-box;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .radio-pill-group {
    display: flex;
    gap: var(--space-xs);
  }

  .radio-pill {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.9rem;
    transition: all var(--transition-fast);
  }

  .radio-pill input {
    display: none;
  }

  .radio-pill:has(input:checked) {
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: 600;
  }

  .checkbox-pill {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .checkbox-pill input {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--color-accent);
  }

  .checkbox-label-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .checkbox-label-text small {
    color: var(--color-text-muted);
  }

  /* Media Previews */
  .media-field-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .thumbnail-slot-wrapper {
    width: 100%;
  }

  .media-drop-preview {
    border: 1.5px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3xl) var(--space-xl);
    background-color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast);
  }

  .media-drop-preview:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .empty-upload-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .prompt-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prompt-text-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .prompt-primary {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .prompt-secondary {
    font-size: 0.775rem;
    color: var(--color-text-muted);
  }

  .thumbnail-chosen-container {
    position: relative;
    max-width: 520px;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 16 / 10;
    background: #000;
    border: 1px solid var(--color-border);
  }

  .thumbnail-chosen-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
  }

  .thumbnail-hover-actions {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.2) 60%,
      transparent 100%
    );
    opacity: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding: var(--space-md);
    transition: opacity var(--transition-fast);
  }

  .thumbnail-chosen-container:hover .thumbnail-hover-actions {
    opacity: 1;
  }

  .thumbnail-chosen-container:hover img {
    transform: scale(1.02);
  }

  .btn-action-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: white;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-action-pill:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .btn-action-danger:hover {
    background: #ef4444;
    border-color: #ef4444;
  }

  /* Gallery Styling */
  .gallery-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
  }

