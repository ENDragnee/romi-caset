---
// Eye button that shows/hides the password <input> placed right before it.
// The parent must be position: relative; give the input right padding
// (~2.75rem) so text doesn't run under the button.
---

<button
  type="button"
  class="pw-toggle"
  aria-label="Show password"
  aria-pressed="false"
  title="Show password"
>
  <svg
    class="pw-eye"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    ><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle
      cx="12"
      cy="12"
      r="3"></circle></svg
  >
  <svg
    class="pw-eye-off"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    ><path
      d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"
    ></path><path
      d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"
    ></path><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path><line
      x1="1"
      y1="1"
      x2="23"
      y2="23"></line></svg
  >
</button>

<script>
  // One delegated listener covers every toggle on the page.
  const set = (btn: HTMLElement, shown: boolean) => {
    const input = btn.previousElementSibling as HTMLInputElement | null;
    if (!input) return;
    input.type = shown ? "text" : "password";
    btn.setAttribute("aria-pressed", String(shown));
    const label = shown ? "Hide password" : "Show password";
    btn.setAttribute("aria-label", label);
    btn.title = label;
  };

  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLElement>(".pw-toggle");
    if (!btn) return;
    set(btn, btn.getAttribute("aria-pressed") !== "true");
    (btn.previousElementSibling as HTMLInputElement | null)?.focus();
  });

  // Never leave a password visible after the form is cleared.
  document.addEventListener("reset", (e) => {
    (e.target as Element)
      .querySelectorAll<HTMLElement>(".pw-toggle")
      .forEach((btn) => set(btn, false));
  });
</script>

<style>
  .pw-toggle {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .pw-toggle:hover,
  .pw-toggle:focus-visible {
    color: var(--color-text);
  }

  .pw-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .pw-eye-off,
  .pw-toggle[aria-pressed="true"] .pw-eye {
    display: none;
  }

  .pw-toggle[aria-pressed="true"] .pw-eye-off {
    display: block;
  }
</style>
