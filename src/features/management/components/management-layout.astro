---
import "../../../styles/global.css";
import ThemeInit from "./theme-init.astro";
import UserMenu from "./user-menu.astro";

interface Props {
  title: string;
  currentPath?: string;
}

const { title, currentPath = "" } = Astro.props;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/management");
}

const navItems = [
  {
    label: "Projects",
    href: "/management/projects",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`,
  },
  {
    label: "Hero Videos",
    href: "/management/hero",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`,
  },
  {
    label: "Media Library",
    href: "/management/media",
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Studio Management</title>
    <ThemeInit />
  </head>

  <body class="mgmt-body">
    <div class="mgmt-layout">
      {/* Sidebar Navigation */}
      <aside class="mgmt-sidebar">
        <div class="sidebar-brand">
          <a
            href="/"
            target="_blank"
            class="brand-link"
            title="Visit live site"
          >
            <span class="brand-logo" role="img" aria-label="Bini Romi"></span>
            <span class="badge-studio">STUDIO</span>
          </a>
        </div>

        <nav class="sidebar-nav">
          <div class="nav-group-title">CONTENT</div>
          <ul class="nav-links">
            {
              navItems.map((item) => {
                const isActive = currentPath.startsWith(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      class={`nav-item ${isActive ? "active" : ""}`}
                    >
                      <span class="item-icon" set:html={item.icon} />
                      <span class="item-label">{item.label}</span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <div class="sidebar-footer">
          <UserMenu
            name={user.name}
            email={user.email}
            settingsActive={currentPath.startsWith("/management/settings")}
          />
        </div>
      </aside>

      {/* Main Content Area */}
      <div class="mgmt-main-wrapper">
        <header class="mgmt-topbar">
          <div class="topbar-title-area">
            <h1 class="page-title">{title}</h1>
          </div>
          <div class="topbar-actions">
            <a href="/" target="_blank" class="btn-view-site">
              <span>View Site</span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                ></path><polyline points="15 3 21 3 21 9"></polyline><line
                  x1="10"
                  y1="14"
                  x2="21"
                  y2="3"></line></svg
              >
            </a>
          </div>
        </header>

        <main class="mgmt-content">
          <slot />
        </main>
      </div>
    </div>

    <style>
      .mgmt-body {
        margin: 0;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        min-height: 100vh;
      }

      .mgmt-layout {
        display: flex;
        min-height: 100vh;
      }

      /* Sidebar */
      /* Exactly one viewport tall and sticky, so it stays in view while the
         page scrolls instead of stretching with the content. */
      .mgmt-sidebar {
        width: 260px;
        background-color: var(--color-surface);
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        align-self: flex-start;
        height: 100vh;
        height: 100dvh;
      }

      .sidebar-brand {
        padding: var(--space-xl) var(--space-lg);
        border-bottom: 1px solid var(--color-border);
      }

      .brand-link {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        text-decoration: none;
      }

      .brand-logo {
        display: block;
        height: 28px;
        width: auto;
        aspect-ratio: 1400 / 632;
        background-color: var(--color-text);
        mask-image: url("/branding/logo-mark-left.png");
        -webkit-mask-image: url("/branding/logo-mark-left.png");
        mask-size: 100% 100%;
        -webkit-mask-size: 100% 100%;
        mask-repeat: no-repeat;
        -webkit-mask-repeat: no-repeat;
      }

      .badge-studio {
        font-family: var(--font-heading);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        background: color-mix(in srgb, var(--color-accent) 15%, transparent);
        color: var(--color-accent);
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        border: 1px solid
          color-mix(in srgb, var(--color-accent) 30%, transparent);
      }

      /* Only the nav scrolls if it outgrows the viewport; brand and the
         account footer stay pinned. */
      .sidebar-nav {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: var(--space-lg) var(--space-md);
      }

      .nav-group-title {
        font-family: var(--font-heading);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: var(--color-text-muted);
        margin-bottom: var(--space-sm);
        padding-left: var(--space-sm);
      }

      .nav-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        padding: var(--space-sm) var(--space-md);
        border-radius: var(--radius-md);
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all var(--transition-fast);
      }

      .nav-item:hover {
        color: var(--color-text);
        background-color: var(--color-surface-elevated);
      }

      .nav-item.active {
        color: var(--color-bg);
        background-color: var(--color-accent);
        font-weight: 600;
      }

      .item-icon {
        display: flex;
        align-items: center;
      }

      .sidebar-footer {
        padding: var(--space-sm);
        border-top: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        background-color: color-mix(
          in srgb,
          var(--color-surface) 50%,
          var(--color-bg)
        );
      }

      /* Main Content Wrapper */
      .mgmt-main-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      .mgmt-topbar {
        height: var(--nav-height);
        border-bottom: 1px solid var(--color-border);
        padding: 0 var(--space-2xl);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: var(--color-surface);
      }

      .page-title {
        font-family: var(--font-heading);
        font-size: 1.35rem;
        margin: 0;
        font-weight: 600;
      }

      .btn-view-site {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: var(--space-2xs) var(--space-sm);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
      }

      .btn-view-site:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
      }

      .mgmt-content {
        flex: 1;
        padding: var(--space-2xl);
        overflow-y: auto;
      }

      @media (max-width: 768px) {
        .mgmt-layout {
          flex-direction: column;
        }
        .mgmt-sidebar {
          width: 100%;
          position: static;
          height: auto;
        }
        .mgmt-content {
          padding: var(--space-lg);
        }
      }
    </style>
  </body>
</html>
