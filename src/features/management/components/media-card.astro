---
interface Props {
  id: string;
  mediaKey: string;
  filename: string;
  size: number;
  width?: number | null;
  height?: number | null;
}

const { id, mediaKey, filename, size, width, height } = Astro.props;

function formatSize(bytes: number) {
  if (bytes < 1024) return bytes + " B";
  const kb = bytes / 1024;
  if (kb < 1024) return kb.toFixed(1) + " KB";
  const mb = kb / 1024;
  return mb.toFixed(1) + " MB";
}
---

<div class="media-card" data-card-id={id}>
  <div class="media-thumbnail">
    <img src={`/api/media/${mediaKey}`} alt={filename} loading="lazy" />
    <div class="media-overlay">
      <button
        type="button"
        class="btn-action copy-key-btn"
        data-key={mediaKey}
        title="Copy S3 Key"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path
            d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
          ></path></svg
        >
      </button>
      <button
        type="button"
        class="btn-action delete-media-btn"
        data-id={id}
        title="Delete asset"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><polyline points="3 6 5 6 21 6"></polyline><path
            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
          ></path></svg
        >
      </button>
    </div>
  </div>

  <div class="media-info">
    <span class="media-filename" title={filename}>{filename}</span>
    <div class="media-meta">
      <span>{formatSize(size)}</span>
      {
        width && height && (
          <span>
            &bull; {width} &times; {height}
          </span>
        )
      }
    </div>
  </div>
</div>

<style>
  .media-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .media-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  .media-thumbnail {
    aspect-ratio: 16/10;
    position: relative;
    background-color: var(--color-bg);
    overflow: hidden;
  }

  .media-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .media-card:hover .media-thumbnail img {
    transform: scale(1.04);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      transparent 60%
    );
    opacity: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    gap: var(--space-2xs);
    padding: var(--space-xs);
    transition: opacity var(--transition-fast);
  }

  .media-card:hover .media-overlay {
    opacity: 1;
  }

  .btn-action {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-action:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .delete-media-btn:hover {
    background: #ef4444;
    border-color: #ef4444;
  }

  .media-info {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .media-filename {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-text);
  }

  .media-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
</style>
