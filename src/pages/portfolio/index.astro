---
import SiteFooter from "@/features/footer/components/site-footer.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import FeaturedCard from "@/features/portfolio/components/featured-card.astro";
import { prisma } from "@/lib/prisma";

// Public, non-personalized page — safe to serve from Vercel's edge cache.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=300, stale-while-revalidate=86400",
);

// Exclusively query database projects in custom order
const dbProjects = await prisma.project.findMany({
  orderBy: [{ order: "asc" }, { createdAt: "desc" }],
});

// Normalize backend category enum (e.g. MUSICVIDEO -> music) for navbar filter button matching
const projects = dbProjects.map((p) => {
  let cat = "film";
  const c = (p.category || "").toUpperCase();
  if (c.includes("MUSIC")) cat = "music";
  else if (c.includes("COMMERCIAL")) cat = "commercial";
  return { ...p, filterCat: cat };
});
---

<BaseLayout title="Work — Bini Romi Filmwork" route="work">
  <div class="work-container">
    <section class="work-grid" id="wgrid">
      {
        projects.length > 0 ? (
          projects.map((p, index) => (
            <FeaturedCard
              id={p.slug}
              client={p.client || "STUDIO"}
              title={p.title}
              category={p.filterCat}
              thumbnail={p.thumbnail}
              priority={index < 3}
            />
          ))
        ) : (
          <div class="no-projects">
            <p>NO PROJECTS PUBLISHED YET.</p>
          </div>
        )
      }
    </section>

    <div class="work-foot">
      <SiteFooter />
    </div>
  </div>
</BaseLayout>

<script>
  function InitWorkPage() {
    // Forcefully remove lock on entering portfolio
    document.documentElement.classList.remove("locked");
    document.body.classList.remove("pre", "pre-logo");
    document.body.style.overflow = "";

    const grid = document.querySelector<HTMLElement>("#wgrid");
    if (!grid) return;

    const projectCards = grid.querySelectorAll<HTMLElement>(".proj");
    // Arrived through a page transition? Then cards in view fade in one by one
    // (.nv = no-vertical-move variant) after the page itself has started fading up.
    const viaTransition = document.body.classList.contains("fx-in");
    projectCards.forEach((el, i) => {
      if (
        viaTransition &&
        el.getBoundingClientRect().top < innerHeight * 1.02
      ) {
        el.classList.add("rise", "nv");
        setTimeout(() => el.classList.add("in"), 380 + 90 * i);
        return;
      }
      setTimeout(() => el.classList.add("in"), 40 * Math.min(i, 8));
    });

    // Handle filter broadcast from navbar
    window.addEventListener("apply-portfolio-filter", (e: any) => {
      const selected = (e.detail?.category || "all").toLowerCase();
      projectCards.forEach((p) => {
        const cat = (p.dataset.cat || "").toLowerCase();
        if (selected === "all" || cat === selected) {
          p.classList.remove("dim");
        } else {
          p.classList.add("dim");
        }
      });
    });

    // Check URL parameters (e.g. /portfolio?category=music)
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get("category") || urlParams.get("cat");
    if (catParam) {
      window.dispatchEvent(
        new CustomEvent("apply-portfolio-filter", {
          detail: { category: catParam },
        }),
      );
      document.querySelectorAll(".cat").forEach((b: any) => {
        b.classList.toggle("on", b.dataset.cat === catParam.toLowerCase());
      });
    }
  }

  InitWorkPage();
  document.addEventListener("astro:page-load", InitWorkPage);
</script>

<style>
  .work-container {
    min-height: 100vh;
    background-color: var(--bg);
  }

  /* Desktop Work Grid (3 Columns) */
  .work-grid {
    --c: 3.4rem;
    --g: 1.8rem;
    --gut: 1.4vw;
    --hcap: calc(
      (100vh - var(--top) + 2.7rem - 2 * var(--c) - 2 * var(--g)) / 2.1
    );
    --wcol: calc((100vw - 2 * var(--m) - 2 * var(--gut)) / 3);
    --w: min(var(--wcol), calc(var(--hcap) * 4 / 3 * 1.14));
    display: grid;
    grid-template-columns: repeat(3, var(--w));
    column-gap: var(--gut);
    row-gap: var(--g);
    justify-content: center;
    padding-top: var(--top);
  }

  .no-projects {
    grid-column: 1 / -1;
    text-align: center;
    padding: 6rem 0;
    font-family: var(--mf);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    opacity: 0.5;
  }

  .work-foot {
    padding-top: 6rem;
  }

  /* Phone Version (2 Columns, Thin Gutters) */
  @media (max-width: 900px) {
    .work-grid {
      /* minmax(0, 1fr), not bare 1fr: a bare 1fr track's automatic minimum
         is its content's min-content width, so one column with a longer
         unbroken caption (white-space:nowrap below) grows wider than the
         other, misaligning every row since .thumb's aspect-ratio makes
         image height follow column width. minmax(0, ...) caps that
         minimum at 0 so both columns stay equal and ellipsis can truncate. */
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      column-gap: 1.55vw !important;
      row-gap: 1.45vw !important;
      padding: var(--top) 3.7vw 0 !important;
      justify-content: stretch !important;
    }

    .work-grid :global(.proj) {
      width: 100% !important;
    }

    .work-grid :global(.cap) {
      height: 10vw !important;
      flex-wrap: nowrap !important;
      gap: 1.2em !important;
      padding: 0 0.15rem !important;
      font-size: clamp(0.46rem, 2.05vw, 0.58rem) !important;
      letter-spacing: 0.02em !important;
      white-space: nowrap !important;
    }

    .work-grid :global(.cap span) {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .work-grid :global(.cap .cl) {
      flex: none;
    }

    .work-foot {
      padding-top: 3rem;
    }
  }
</style>
