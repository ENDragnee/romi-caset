---
import BaseLayout from "../../layouts/base-layout.astro";
import ProjectGrid from "../../features/portfolio/components/project-grid.astro";
import { prisma } from "@/lib/prisma";

const allProjects = await prisma.project.findMany({
  orderBy: [{ order: "asc" }, { createdAt: "desc" }],
});

const categories = [
  { label: "ALL", value: "ALL" },
  { label: "COMMERCIALS", value: "COMMERCIAL" },
  { label: "MUSIC VIDEOS", value: "MUSICVIDEO" },
  { label: "FILMS", value: "FILM" },
];
---

<BaseLayout title="Projects — Kaset Production">
  <section class="section portfolio-page">
    <div class="content-wrapper">
      {/* Category Tabs */}
      <header class="portfolio-header-block hero-title-drop">
        <div class="title-with-count">
          <h1 class="portfolio-huge-title">PROJECTS</h1>
          <span id="projects-count-badge" class="projects-count-badge"
            >[{allProjects.length}]</span
          >
        </div>

        <nav
          class="category-tabs-left"
          aria-label="Filter portfolio categories"
        >
          {
            categories.map((cat, index) => (
              <button
                type="button"
                class={`tab-btn ${index === 0 ? "active" : ""}`}
                data-category={cat.value}
              >
                <span>{cat.label}</span>
              </button>
            ))
          }
        </nav>
      </header>

      {/* Expansive Project Grid */}
      <div class="content-rise-up">
        <ProjectGrid projects={allProjects} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function InitPortfolioFilters() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const countBadge = document.querySelector<HTMLElement>(
      "#projects-count-badge",
    );
    const gridItems = document.querySelectorAll<HTMLElement>(
      ".portfolio-grid-container .grid-item",
    );

    if (!tabBtns.length || !gridItems.length) return;

    function filterCategory(targetCategory: string) {
      const normalizedTarget = (targetCategory || "ALL").trim().toUpperCase();
      let matchCount = 0;

      tabBtns.forEach((btn) => {
        const btnCat = (btn.dataset.category || "").trim().toUpperCase();
        if (btnCat === normalizedTarget) {
          btn.classList.add("active");
          btn.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "nearest",
          });
        } else {
          btn.classList.remove("active");
        }
      });

      gridItems.forEach((item) => {
        const itemCat = (item.dataset.category || "").trim().toUpperCase();
        const isMatch =
          normalizedTarget === "ALL" || itemCat === normalizedTarget;

        if (isMatch) {
          item.classList.remove("is-dimmed");
          matchCount++;
        } else {
          item.classList.add("is-dimmed");
        }
      });

      if (countBadge) {
        countBadge.classList.remove("count-pop");
        void countBadge.offsetWidth;
        countBadge.textContent = `[${matchCount}]`;
        countBadge.classList.add("count-pop");
      }
    }

    tabBtns.forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        const category = btn.dataset.category || "ALL";
        filterCategory(category);

        const url = new URL(window.location.href);
        if (category === "ALL") {
          url.searchParams.delete("category");
        } else {
          url.searchParams.set("category", category);
        }
        window.history.replaceState({}, "", url.toString());
      };
    });

    window.addEventListener("apply-portfolio-filter", (e: any) => {
      const category = e.detail?.category || "ALL";
      filterCategory(category);
    });

    const currentParams = new URLSearchParams(window.location.search);
    const initialCategory = currentParams.get("category");
    if (initialCategory) {
      filterCategory(initialCategory);
    }
  }

  InitPortfolioFilters();
  document.addEventListener("astro:page-load", InitPortfolioFilters);
</script>

<style>
  .portfolio-page {
    padding-top: calc(var(--nav-height) + var(--space-xl));
    padding-bottom: var(--space-5xl);
    width: 100%;
  }

  /* Wide Canvas (1380px) */
  .content-wrapper {
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
    padding-inline: var(--space-xl);
    box-sizing: border-box;
  }

  .portfolio-header-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: var(--space-3xl);
    width: 100%;
  }

  .title-with-count {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 0.9;
  }

  .portfolio-huge-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 12vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.88;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0;
  }

  .projects-count-badge {
    font-family: var(--font-heading);
    font-size: clamp(0.9rem, 3vw, 1.85rem);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-top: 4px;
    display: inline-block;
  }

  .category-tabs-left {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
    padding: 4px 0;
    overflow-x: auto;
    max-width: 100%;
    scrollbar-width: none;
  }

  .category-tabs-left::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 0.825rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8c8c8c;
    padding: 2px 0;
    white-space: nowrap;
    position: relative;
    transition: color var(--transition-fast);
  }

  .tab-btn:hover {
    color: #333333;
  }

  .tab-btn.active {
    color: #000000;
    font-weight: 800;
  }

  .tab-btn.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: #000000;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      padding-inline: var(--space-md);
    }
    .category-tabs-left {
      gap: 16px;
    }
  }
</style>
