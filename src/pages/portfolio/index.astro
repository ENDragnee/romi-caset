---
import BaseLayout from "../../layouts/base-layout.astro";
import ProjectGrid from "../../features/portfolio/components/project-grid.astro";
import { prisma } from "@/lib/prisma";

const allProjects = await prisma.project.findMany({
  orderBy: { createdAt: "desc" },
});

const categories = [
  { label: "All Work", value: "ALL" },
  { label: "Music Videos", value: "MUSICVIDEO" },
  { label: "Commercials", value: "COMMERCIAL" },
  { label: "Films", value: "FILM" },
];
---

<BaseLayout title="Portfolio — Kaset Production">
  <section class="section portfolio-page">
    <div class="content-wrapper">
      {/* Category Tabs */}
      <div class="portfolio-tabs-container hero-title-drop">
        <nav class="category-tabs" aria-label="Filter portfolio categories">
          {
            categories.map((cat, index) => (
              <button
                type="button"
                class={`tab-btn ${index === 0 ? "active" : ""}`}
                data-category={cat.value}
              >
                <span>{cat.label}</span>
              </button>
            ))
          }
        </nav>
      </div>

      {/* Reactive Project Grid */}
      <div class="content-rise-up">
        <ProjectGrid projects={allProjects} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function InitPortfolioFilters() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const gridItems = document.querySelectorAll<HTMLElement>(
      ".portfolio-grid-container .grid-item",
    );

    if (!tabBtns.length || !gridItems.length) return;

    function filterCategory(targetCategory: string) {
      const normalizedTarget = (targetCategory || "ALL").trim().toUpperCase();

      // 1. Update Tab Buttons
      tabBtns.forEach((btn) => {
        const btnCat = (btn.dataset.category || "").trim().toUpperCase();
        if (btnCat === normalizedTarget) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });

      // 2. Grey out / Spotlight Grid Items
      gridItems.forEach((item) => {
        const itemCat = (item.dataset.category || "").trim().toUpperCase();
        const isMatch =
          normalizedTarget === "ALL" || itemCat === normalizedTarget;

        if (isMatch) {
          item.classList.remove("is-dimmed");
        } else {
          item.classList.add("is-dimmed");
        }
      });
    }

    // Attach click events
    tabBtns.forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        const category = btn.dataset.category || "ALL";
        filterCategory(category);

        const url = new URL(window.location.href);
        if (category === "ALL") {
          url.searchParams.delete("category");
        } else {
          url.searchParams.set("category", category);
        }
        window.history.replaceState({}, "", url.toString());
      };
    });

    // Check URL parameters on initial load / navigation
    const currentParams = new URLSearchParams(window.location.search);
    const initialCategory = currentParams.get("category");
    if (initialCategory) {
      filterCategory(initialCategory);
    }
  }

  InitPortfolioFilters();
  document.addEventListener("astro:page-load", InitPortfolioFilters);
</script>

<style>
  .portfolio-page {
    padding-top: calc(var(--nav-height) + var(--space-xl));
    padding-bottom: var(--space-5xl);
    width: 100%;
  }

  .content-wrapper {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding-inline: var(--space-md);
    box-sizing: border-box;
  }

  /* Category Tabs */
  .portfolio-tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-2xl);
    width: 100%;
  }

  .category-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    padding: var(--space-2xs) 0;
    overflow-x: auto;
    max-width: 100%;
    scrollbar-width: none;
  }

  .category-tabs::-webkit-scrollbar {
    display: none;
  }

  /* Non-selected tabs are greyed out */
  .tab-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35); /* Greyed out default */
    padding: var(--space-2xs) var(--space-xs);
    white-space: nowrap;
    position: relative;
    transition: color var(--transition-fast);
  }

  .tab-btn:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Active selected tab is highlighted white */
  .tab-btn.active {
    color: #ffffff;
    font-weight: 600;
  }

  .tab-btn.active::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .category-tabs {
      gap: var(--space-lg);
      justify-content: flex-start;
      padding-inline: var(--space-xs);
    }

    .tab-btn {
      font-size: 0.85rem;
      letter-spacing: 0.08em;
    }
  }
</style>
