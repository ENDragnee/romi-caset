---
import BaseLayout from "../../layouts/base-layout.astro";
import VideoEmbed from "../../features/project-detail/components/video-embed.astro";
import GalleryGrid from "../../features/project-detail/components/gallery-grid.astro";
import { prisma } from "@/lib/prisma";

const { slug } = Astro.params;
const project = await prisma.project.findUnique({
  where: { slug: slug as string },
});
if (!project) return Astro.redirect("/portfolio");
---

<BaseLayout title={`${project.title} — Kaset Production`}>
  <main class="project-detail">
    <div class="content-wrapper">
      {/* Video with Title on the Player */}
      <div class="project-content content-rise-up">
        {
          project.youtubeUrl && (
            <div class="video-container hero-title-drop">
              <VideoEmbed
                url={project.youtubeUrl}
                title={project.title}
                thumbnail={project.thumbnail}
              />
            </div>
          )
        }

        {/* Client Name & Year directly below the video */}
        {
          (project.client || project.year) && (
            <div class="project-client-meta">
              <p class="client-text">
                {project.client}
                {project.client && project.year && (
                  <span class="meta-sep">&mdash;</span>
                )}
                {project.year && <span class="year-num">{project.year}</span>}
              </p>
            </div>
          )
        }

        {/* Behind The Scenes Stills */}
        {
          project.gallery && project.gallery.length > 0 && (
            <div class="gallery-section">
              <GalleryGrid images={project.gallery} alt={project.title} />
            </div>
          )
        }

        {/* Back to Portfolio Link */}
        <div class="back-link-container">
          <a href="/portfolio" class="back-link">← Back to Projects</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .project-detail {
    padding-top: calc(var(--nav-height) + var(--space-xl));
    padding-bottom: var(--space-5xl);
    width: 100%;
  }

  /* Wide Canvas (1380px) matching Portfolio Index */
  .content-wrapper {
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
    padding-inline: var(--space-xl);
    box-sizing: border-box;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .video-container {
    width: 100%;
    margin: 0 auto var(--space-lg);
  }

  /* Client & Year Row below video */
  .project-client-meta {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .client-text {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .meta-sep {
    margin-inline: 6px;
    color: var(--color-border-strong);
  }

  .year-num {
    color: var(--color-text);
  }

  .gallery-section {
    width: 100%;
    margin-bottom: var(--space-4xl);
  }

  .back-link-container {
    display: flex;
    justify-content: center;
    margin-top: var(--space-3xl);
  }

  .back-link {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 600;
    transition: opacity var(--transition-fast);
  }

  .back-link:hover {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      padding-inline: var(--space-md);
    }
    .video-container {
      margin-bottom: var(--space-md);
    }
    .project-client-meta {
      margin-bottom: var(--space-2xl);
    }
  }
</style>
