---
import BaseLayout from "../layouts/base-layout.astro";
import ContactForm from "../features/contact/components/contact-form.astro";
---

<BaseLayout title="Contact — Kaset Production">
  <section class="section container contact-page">
    <div class="content-wrapper">
      {/* Clean Divider Header */}
      <div class="divider hero-title-drop">
        <span class="divider__label">Get In Touch</span>
      </div>

      {/* Grid */}
      <div class="contact-grid content-rise-up">
        <div class="contact-info">
          <h1 class="contact-heading">Let's create something remarkable.</h1>
          <p class="contact-text">
            Whether you're looking to shoot a music video, commercial, or
            narrative film, we'd love to hear about your project vision. Fill
            out the inquiry form or reach out directly.
          </p>

          <div class="contact-direct-block">
            <span class="direct-label">DIRECT INQUIRIES</span>
            <a href="mailto:hello@kasetproduction.com" class="contact-link">
              hello@kasetproduction.com
            </a>
          </div>
        </div>

        <div class="contact-form-wrapper">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: var(--space-5xl);
  }

  .content-wrapper {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding-inline: var(--space-md);
    box-sizing: border-box;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--space-4xl);
    margin-top: var(--space-2xl);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    max-width: 440px;
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 var(--space-lg) 0;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .contact-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-2xl) 0;
  }

  .contact-direct-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .direct-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-link {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .contact-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3xl);
    }
  }
</style>
