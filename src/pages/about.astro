---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="About — Kaset Production">
  <div class="about-container">
    <div class="about-card content-rise-up">
      {/* Dictionary definition style header */}
      <div class="definition-header">
        <h1 class="word-title">kaset.</h1>
        <span class="phonetic">/ ˈkæ.sɛt /</span>
        <div class="definition-line"></div>
      </div>

      {/* Manifesto & Studio Statement */}
      <div class="definition-body">
        <p class="meaning-text">
          A physical medium for capturing analog warmth, raw motion, and sonic
          synchronicity. A canvas for preserving light, sound, and fleeting
          human emotion onto tape.
        </p>

        <p class="studio-text">
          Kaset is an independent creative studio and production company
          crafting cinematic music videos, commercials, and narrative films.
        </p>

        <p class="location-text">Based in London & Available Worldwide.</p>
      </div>

      {/* Minimal Footer Links */}
      <div class="about-socials">
        <span class="socials-label">FIND US ON</span>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer">instagram</a
        >
        <span class="separator">/</span>
        <a href="https://vimeo.com" target="_blank" rel="noopener noreferrer"
          >vimeo</a
        >
        <span class="separator">/</span>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer"
          >youtube</a
        >
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-height) + var(--space-xl)) var(--space-lg)
      var(--space-4xl);
    box-sizing: border-box;
  }

  .about-card {
    max-width: 520px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Wordmark & Phonetic Header */
  .definition-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .word-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
    line-height: 1;
  }

  .phonetic {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .definition-line {
    width: 100%;
    height: 1px;
    background-color: var(--color-border);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  /* Body Text */
  .definition-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .meaning-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text);
    font-weight: 400;
    margin: 0;
  }

  .studio-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  .location-text {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* Bottom Social Links */
  .about-socials {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--space-2xl);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .socials-label {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .about-socials a {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .about-socials a:hover {
    color: var(--color-accent);
  }

  .separator {
    color: var(--color-border);
  }
</style>
