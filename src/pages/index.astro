---
import BaseLayout from "../layouts/base-layout.astro";
import HeroVideo from "../features/hero/components/hero-video.astro";
import Preloader from "../features/hero/components/preloader.astro";
import ProjectGrid from "../features/portfolio/components/project-grid.astro";
import { prisma } from "@/lib/prisma";

const featuredProjects = await prisma.project.findMany({
  where: { featured: true },
  take: 6,
  orderBy: { createdAt: "desc" },
});
---

<BaseLayout title="Kaset Production" transparentNav={true}>
  {/* 5-Second ROMI Buffer Screen */}
  <Preloader />

  <div class="homepage-curtain-wrapper">
    {/* Pinned Hero Section */}
    <div class="sticky-hero-container" id="hero-wrapper">
      <HeroVideo />
    </div>

    {/* Rising Featured Section */}
    <section class="section featured-section" id="featured-section">
      <div class="content-wrapper">
        <div class="divider hero-title-drop">
          <span class="divider__label">Selected Work</span>
        </div>

        <div class="content-rise-up">
          <ProjectGrid projects={featuredProjects} />
        </div>

        <div class="view-all-wrapper">
          <a href="/portfolio" class="view-all-link">View All Work →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .homepage-curtain-wrapper {
    position: relative;
    width: 100%;
  }

  .sticky-hero-container {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1;
    will-change: transform;
  }

  .featured-section {
    position: relative;
    z-index: 2;
    background-color: var(--color-bg);
    width: 100%;
    min-height: 100vh;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-5xl);
    box-shadow: 0 -25px 60px rgba(0, 0, 0, 0.9);
    box-sizing: border-box;
  }

  .content-wrapper {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding-inline: var(--space-md);
    box-sizing: border-box;
  }

  .view-all-wrapper {
    display: flex;
    justify-content: center;
    margin-top: var(--space-3xl);
  }

  .view-all-link {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-all-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--color-accent);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-all-link:hover {
    transform: translateX(4px);
  }

  .view-all-link:hover::after {
    width: 100%;
  }
</style>
