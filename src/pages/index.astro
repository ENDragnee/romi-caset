---
import BaseLayout from "../layouts/base-layout.astro";
import HeroVideo from "../features/hero/components/hero-video.astro";
import Preloader from "../features/hero/components/preloader.astro";
import ProjectGrid from "../features/portfolio/components/project-grid.astro";
import { prisma } from "@/lib/prisma";

// 1. Fetch active hero video reels in custom order
const heroVideoRecords = await prisma.heroVideo.findMany({
  where: { active: true },
  orderBy: [{ order: "asc" }, { createdAt: "desc" }],
});

const heroVideoUrls =
  heroVideoRecords.length > 0
    ? heroVideoRecords.map((v) => `/api/media/${v.key}`)
    : ["/videos/hero-video.mp4"];

// 2. Fetch featured portfolio projects in custom order
const featuredProjects = await prisma.project.findMany({
  where: { featured: true },
  take: 6,
  orderBy: [{ order: "asc" }, { createdAt: "desc" }],
});

const tickerText =
  "We believe a great film doesn’t just tell you something. It makes you feel something";
---

<BaseLayout title="Kaset Production" transparentNav={true}>
  {/* 5-Second 3D ROMI Buffer Preloader with Live Status */}
  <Preloader />

  <div class="homepage-curtain-wrapper">
    {/* Pinned Sticky Hero Section */}
    <div class="sticky-hero-container" id="hero-wrapper">
      <HeroVideo videos={heroVideoUrls} />
    </div>

    {/* Rising Featured Section */}
    <section class="section featured-section" id="featured-section">
      <div class="content-wrapper">
        <div class="divider hero-title-drop">
          <span class="divider__label">Selected Work</span>
        </div>

        <div class="content-rise-up">
          <ProjectGrid projects={featuredProjects} />
        </div>

        <div class="view-all-wrapper">
          <a href="/portfolio" class="view-all-link">View All Work →</a>
        </div>
      </div>

      {/* Infinite Horizontal Marquee Ticker */}
      <div class="marquee-container" aria-label={tickerText}>
        <div class="marquee-track">
          <div class="marquee-item">
            <span>{tickerText}</span>
            <span>{tickerText}</span>
          </div>
          <div class="marquee-item" aria-hidden="true">
            <span>{tickerText}</span>
            <span class="marquee-spacer">—</span>
            <span>{tickerText}</span>
            <span class="marquee-spacer">—</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .homepage-curtain-wrapper {
    position: relative;
    width: 100%;
  }

  /* Pinned Hero */
  .sticky-hero-container {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1;
    will-change: transform;
  }

  /* Rising Featured Section covering the pinned hero */
  .featured-section {
    position: relative;
    z-index: 2;
    background-color: var(--color-bg);
    width: 100%;
    min-height: 100vh;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-5xl);
    box-shadow: 0 -25px 60px rgba(0, 0, 0, 0.9);
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .content-wrapper {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding-inline: var(--space-md);
    box-sizing: border-box;
  }

  .view-all-wrapper {
    display: flex;
    justify-content: center;
    margin-top: var(--space-3xl);
  }

  .view-all-link {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-all-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--color-accent);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-all-link:hover {
    transform: translateX(4px);
  }

  .view-all-link:hover::after {
    width: 100%;
  }

  /* ---------- Full-Width Continuous Marquee ---------- */
  .marquee-container {
    width: 100%;
    overflow: hidden;
    user-select: none;
    margin-top: var(--space-4xl);
    padding-block: var(--space-md);
    display: flex;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marqueeScroll 35s linear infinite;
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .marquee-spacer {
    display: inline-block;
    margin-inline: var(--space-xl);
    opacity: 0.45;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
