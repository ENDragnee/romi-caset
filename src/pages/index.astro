---
import BaseLayout from "../layouts/base-layout.astro";
import HeroVideo from "../features/hero/components/hero-video.astro";
import Preloader from "../features/hero/components/preloader.astro";
import ProjectGrid from "../features/portfolio/components/project-grid.astro";
import { prisma } from "@/lib/prisma";

// 1. Fetch active hero video reels in custom order
const heroVideoRecords = await prisma.heroVideo.findMany({
  where: { active: true },
  orderBy: [{ order: "asc" }, { createdAt: "desc" }],
});

const heroVideoUrls =
  heroVideoRecords.length > 0
    ? heroVideoRecords.map((v) => `/api/media/${v.key}`)
    : ["/videos/hero-video.mp4"];

// 2. Fetch featured portfolio projects in custom order
const featuredProjects = await prisma.project.findMany({
  where: { featured: true },
  take: 6,
  orderBy: [{ order: "asc" }, { createdAt: "desc" }],
});

const tickerText =
  "We believe a great film doesn’t just tell you something. It makes you feel something";
---

<BaseLayout title="Kaset Production" transparentNav={true}>
  {/* 5-Second 3D ROMI Buffer Preloader */}
  <Preloader />

  <div class="homepage-curtain-wrapper">
    {/* Pinned Sticky Hero Section */}
    <div class="sticky-hero-container" id="hero-wrapper">
      <HeroVideo videos={heroVideoUrls} />
    </div>

    {/* Rising Featured Section */}
    <section class="section featured-section" id="featured-section">
      {/* Infinite Horizontal Marquee Ticker */}
      <div class="marquee-container" aria-label={tickerText}>
        <div class="marquee-track">
          <div class="marquee-item">
            <span>{tickerText}</span>
            <span class="marquee-spacer">—</span>
            <span>{tickerText}</span>
            <span class="marquee-spacer">—</span>
          </div>
          <div class="marquee-item" aria-hidden="true">
            <span>{tickerText}</span>
            <span class="marquee-spacer">—</span>
            <span>{tickerText}</span>
            <span class="marquee-spacer">—</span>
          </div>
        </div>
      </div>

      <div class="content-wrapper">
        <div class="content-rise-up">
          <ProjectGrid projects={featuredProjects} />
        </div>

        <div class="view-all-wrapper">
          <a href="/portfolio" class="view-all-link">View All Work →</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function InitCurtainScroll() {
    const scrollToHeroBtn = document.querySelector<HTMLButtonElement>(
      "#scroll-to-hero-btn",
    );

    if (scrollToHeroBtn) {
      scrollToHeroBtn.onclick = (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      };
    }
  }

  InitCurtainScroll();
  document.addEventListener("astro:page-load", InitCurtainScroll);
</script>

<style>
  .homepage-curtain-wrapper {
    position: relative;
    width: 100%;
    background-color: #ffffff;
  }

  /* Pinned Hero */
  .sticky-hero-container {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1;
    will-change: transform;
  }

  /* Rising Featured Section */
  .featured-section {
    position: relative;
    z-index: 2;
    background-color: #ffffff;
    width: 100%;
    min-height: 100vh;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-4xl);
    box-shadow: 0 -25px 60px rgba(0, 0, 0, 0.15); /* Soft, clean elevation on light theme */
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .content-wrapper {
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
    padding-inline: var(--space-xl);
    box-sizing: border-box;
  }

  .view-all-wrapper {
    display: flex;
    justify-content: center;
    margin-top: var(--space-4xl);
  }

  .view-all-link {
    color: #000000;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-all-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: #000000;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .view-all-link:hover {
    transform: translateX(4px);
  }

  .view-all-link:hover::after {
    width: 100%;
  }

  /* Minimal Up-Navigation to Hero */
  .return-hero-wrapper {
    display: flex;
    justify-content: center;
    margin-top: var(--space-4xl);
  }

  .hero-scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: var(--space-xs) var(--space-md);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .hero-scroll-cue:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .cue-label {
    font-family: var(--font-heading);
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    text-transform: uppercase;
  }

  @keyframes cuePulseUp {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.75;
    }
    50% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  .cue-chevron-up {
    animation: cuePulseUp 2s infinite ease-in-out;
  }

  /* ---------- Full-Width Continuous Marquee ---------- */
  .marquee-container {
    width: 100%;
    overflow: hidden;
    user-select: none;
    margin-bottom: var(--space-4xl);
    padding-block: var(--space-md);
    display: flex;
    white-space: nowrap;
    border-bottom: 1px solid var(--color-border);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marqueeScroll 35s linear infinite;
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: clamp(0.9rem, 1.8vw, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .marquee-spacer {
    display: inline-block;
    margin-inline: var(--space-xl);
    opacity: 0.35;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .content-wrapper {
      padding-inline: var(--space-md);
    }
  }
</style>
