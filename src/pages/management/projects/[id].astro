---
import { prisma } from "@/lib/prisma";
import ManagementLayout from "../../../features/management/components/management-layout.astro";
import ProjectForm from "../../../features/management/components/project-form.astro";

const { id } = Astro.params;
const project = await prisma.project.findUnique({ where: { id } });

if (!project) {
  return Astro.redirect("/management/projects");
}
---

<ManagementLayout
  title={`Edit Project: ${project.title}`}
  currentPath="/management/projects"
>
  <div class="page-container">
    <div class="page-header-row">
      <div>
        <a href="/management/projects" class="back-link">← Back to Projects</a>
        <h2 class="form-title">Edit Project</h2>
      </div>
      <button
        type="button"
        id="delete-project-btn"
        class="btn-danger-outline"
        data-id={project.id}
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><polyline points="3 6 5 6 21 6"></polyline><path
            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
          ></path></svg
        >
        <span>Delete Project</span>
      </button>
    </div>

    {/* Modular Project Form */}
    <ProjectForm project={project} mode="edit" />
  </div>

  <script>
    const deleteBtn = document.querySelector<HTMLButtonElement>(
      "#delete-project-btn",
    );
    deleteBtn?.addEventListener("click", async () => {
      const id = deleteBtn.dataset.id;
      if (!id) return;

      if (
        confirm("Are you sure you want to permanently delete this project?")
      ) {
        try {
          const res = await fetch(`/api/management/projects/${id}`, {
            method: "DELETE",
          });
          if (res.ok) {
            window.location.href = "/management/projects";
          } else {
            alert("Failed to delete project");
          }
        } catch {
          alert("Error deleting project");
        }
      }
    });
  </script>
</ManagementLayout>

<style>
  .page-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .page-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-block;
    margin-bottom: var(--space-2xs);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .form-title {
    font-size: 1.5rem;
    font-family: var(--font-heading);
    margin: 0;
    font-weight: 600;
  }

  .btn-danger-outline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    color: #ef4444;
    border: 1px solid color-mix(in srgb, #ef4444 30%, transparent);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-danger-outline:hover {
    background-color: color-mix(in srgb, #ef4444 10%, transparent);
    border-color: #ef4444;
  }
</style>
