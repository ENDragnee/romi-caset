---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  transparentNav?: boolean;
}

const {
  title = "Kaset Production",
  description = "Music video, commercial, and film production & editing.",
  transparentNav = false,
} = Astro.props;

import NavBar from "../features/navigation/components/nav-bar.astro";
import SiteFooter from "../features/footer/components/site-footer.astro";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    {/* Astro View Transitions Engine */}
    <ClientRouter />
  </head>

  <body class="site-body">
    <NavBar transparent={transparentNav} />

    <main id="main-content" class="page-content-frame">
      <slot />
    </main>

    <SiteFooter />

    {/* Custom cursor elements */}
    <div class="custom-cursor" aria-hidden="true"></div>
    <div class="custom-cursor--pointer" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M1.5 1.5L14 7L8 9L6 14.5L1.5 1.5Z"
          fill="currentColor"
          stroke="var(--color-bg)"
          stroke-width="1"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <script>
      function InitCursor() {
        const ring = document.querySelector<HTMLElement>(".custom-cursor");
        const pointer = document.querySelector<HTMLElement>(
          ".custom-cursor--pointer",
        );
        if (!ring || !pointer) return;

        if (!window.matchMedia("(pointer: fine)").matches) return;

        document.body.classList.add("has-custom-cursor");

        const activeRing = ring;
        const activePointer = pointer;

        let mouseX = -100;
        let mouseY = -100;
        let ringX = -100;
        let ringY = -100;
        let prevMouseX = -100;
        let prevMouseY = -100;
        let isOverIframe = false;

        const hideCursor = () => {
          activeRing.classList.remove("custom-cursor--visible");
          activePointer.classList.remove("custom-cursor--visible");
        };

        const showCursor = () => {
          if (!isOverIframe) {
            activeRing.classList.add("custom-cursor--visible");
            activePointer.classList.add("custom-cursor--visible");
          }
        };

        document.addEventListener("mousemove", (e: MouseEvent) => {
          if (isOverIframe) return;
          mouseX = e.clientX;
          mouseY = e.clientY;
          showCursor();
        });

        // Kinetic physics loop: smooth follow & motion blur
        function AnimateCursor() {
          if (!isOverIframe) {
            const vx = mouseX - ringX;
            const vy = mouseY - ringY;
            ringX += vx * 0.22;
            ringY += vy * 0.22;

            const mouseVx = mouseX - prevMouseX;
            const mouseVy = mouseY - prevMouseY;
            const speed = Math.hypot(mouseVx, mouseVy);
            const angle = Math.atan2(mouseVy, mouseVx) * (180 / Math.PI);

            prevMouseX = mouseX;
            prevMouseY = mouseY;

            const blurAmount = Math.min(speed * 0.12, 3.5);
            const stretch = Math.min(speed * 0.015, 0.45);
            const squeeze = Math.min(speed * 0.008, 0.25);

            activeRing.style.left = `${ringX}px`;
            activeRing.style.top = `${ringY}px`;
            activeRing.style.filter =
              blurAmount > 0.3 ? `blur(${blurAmount * 0.8}px)` : "none";

            if (speed > 2.5) {
              activeRing.style.transform = `translate(-50%, -50%) rotate(${angle}deg) scale(${1 + stretch}, ${1 - squeeze})`;
            } else {
              activeRing.style.transform = `translate(-50%, -50%) scale(1)`;
            }

            activePointer.style.left = `${mouseX}px`;
            activePointer.style.top = `${mouseY}px`;
            activePointer.style.filter =
              blurAmount > 0.4 ? `blur(${blurAmount * 0.4}px)` : "none";
          }
          requestAnimationFrame(AnimateCursor);
        }
        AnimateCursor();

        // Enlarge on interactive buttons/links
        const interactiveSelector =
          'a, button, [role="button"], input, textarea, select, label';
        document.querySelectorAll(interactiveSelector).forEach((el) => {
          el.addEventListener("mouseenter", () =>
            activeRing.classList.add("custom-cursor--hover"),
          );
          el.addEventListener("mouseleave", () =>
            activeRing.classList.remove("custom-cursor--hover"),
          );
        });

        // Only hide over external sandboxed iframes (e.g. YouTube player), NOT background videos
        const iframeZones = document.querySelectorAll<HTMLElement>(
          "iframe, [data-video-embed]",
        );
        iframeZones.forEach((zone) => {
          zone.addEventListener("mouseenter", () => {
            isOverIframe = true;
            hideCursor();
          });
          zone.addEventListener("mouseleave", () => {
            isOverIframe = false;
            showCursor();
          });
        });

        document.addEventListener("mouseleave", hideCursor);
        window.addEventListener("blur", () => {
          isOverIframe = true;
          hideCursor();
        });
        window.addEventListener("focus", () => {
          isOverIframe = false;
        });
      }

      InitCursor();
      document.addEventListener("astro:page-load", InitCursor);
    </script>
  </body>
</html>

<style>
  .site-body {
    background-color: var(--color-bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page-content-frame {
    flex: 1;
    width: 100%;
    box-sizing: border-box;
  }
</style>
