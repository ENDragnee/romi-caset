---
import { ClientRouter } from "astro:transitions";
import NavBar from "@/features/navigation/components/nav-bar.astro";
import "../styles/theme.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  route?: "home" | "work" | "about" | "contact" | "project";
}

const {
  title = "Bini Romi Filmwork",
  description = "Independent production house creating bold, cinematic films, commercials, and music videos.",
  // Safe default: only the real "/" is the landing page. A page that forgets to pass
  // `route` must NOT be treated as home (that triggers the preloader + scroll lock).
  route = Astro.url.pathname === "/" ? "home" : "project",
} = Astro.props;

const isHome = route === "home";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23E1E1D7'/%3E%3Cpath d='M18 26h38c6 0 8 3 12 8s8 8 14 8v32H18z' fill='%23000'/%3E%3C/svg%3E"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />

    <!-- THEME: one source of truth. Runs before first paint, and only once per session
         (Astro does not re-run identical head scripts on ClientRouter navigations). -->
    <script is:inline>
      (function () {
        if (window.__brTheme) return;
        var KEY = "br-theme";
        function read() {
          try {
            var t = localStorage.getItem(KEY) || sessionStorage.getItem(KEY);
            if (t === "dark" || t === "light") return t;
          } catch (e) {}
          return null;
        }
        function write(t) {
          try {
            localStorage.setItem(KEY, t);
            sessionStorage.setItem(KEY, t);
          } catch (e) {}
        }
        function apply(root, t) {
          root.setAttribute("data-theme", t);
          root.style.colorScheme = t;
        }
        var api = {
          // the LIVE document is the truth during a session; storage seeds it on a fresh load
          get: function () {
            return document.documentElement.getAttribute("data-theme") ===
              "dark"
              ? "dark"
              : "light";
          },
          set: function (t) {
            t = t === "dark" ? "dark" : "light";
            apply(document.documentElement, t);
            write(t);
          },
          toggle: function () {
            api.set(api.get() === "dark" ? "light" : "dark");
          },
        };
        window.__brTheme = api;
        apply(document.documentElement, read() || "light");

        // ClientRouter overwrites <html> attributes with the NEW page's (hardcoded light).
        // Hand the incoming document the current theme BEFORE the swap...
        document.addEventListener("astro:before-swap", function (e) {
          apply(e.newDocument.documentElement, api.get());
        });
        // ...and re-assert it right after, as a safety net.
        document.addEventListener("astro:after-swap", function () {
          apply(document.documentElement, api.get());
        });
        // One delegated handler for every #theme button (the navbar is re-created each page).
        document.addEventListener("click", function (e) {
          var b = e.target instanceof Element && e.target.closest("#theme");
          if (!b) return;
          e.preventDefault();
          api.toggle();
        });
        // Keep other tabs in sync.
        window.addEventListener("storage", function (e) {
          if (
            e.key === KEY &&
            (e.newValue === "dark" || e.newValue === "light")
          )
            apply(document.documentElement, e.newValue);
        });
      })();
    </script>

    <script is:inline define:vars={{ isHome }}>
      // Only lock if we are strictly on the landing page
      if (isHome) {
        document.documentElement.classList.add("locked");
      } else {
        document.documentElement.classList.remove("locked");
      }
    </script>
  </head>
  <body class={isHome ? "pre" : ""} data-route={route}>
    <NavBar />

    <main id="page">
      <slot />
    </main>

    <div id="grain" aria-hidden="true"></div>

    <!-- Custom Cursor -->
    <div class="custom-cursor" aria-hidden="true"></div>
    <div class="custom-cursor--pointer" aria-hidden="true">
      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1.5 1.5L14 7L8 9L6 14.5L1.5 1.5Z" fill="currentColor"
        ></path>
      </svg>
    </div>

    <script>
      // Automatically unlock scroll on View Transitions navigation
      function unlockForNavigation() {
        const isHomePage = window.location.pathname === "/";
        if (!isHomePage) {
          document.documentElement.classList.remove("locked");
          document.body.classList.remove("pre", "pre-logo");
          document.body.style.overflow = "";
        }
      }

      document.addEventListener(
        "astro:before-preparation",
        unlockForNavigation,
      );
      document.addEventListener("astro:page-load", unlockForNavigation);

      // ==================================================================
      // PAGE TRANSITION (matches the reference): the page fades to blank,
      // holds a beat, the new page fades up, thumbnails follow one by one.
      //   out  0.45s  (CSS: body.fx-out)
      //   hold 0.30s  (blank)
      //   in   0.85s  (CSS: body.fx-in on the NEW body)
      // ==================================================================
      const OUT_MS = 450;
      const HOLD_MS = 300;
      const reduceMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      document.addEventListener("astro:before-preparation", (e: any) => {
        if (reduceMotion() || e.from?.href === e.to?.href) return;
        const original = e.loader;
        e.loader = async () => {
          document.body.classList.add("fx-out");
          // fade+hold run IN PARALLEL with the fetch, so it never adds dead time on a slow link
          const blank = new Promise<void>((r) =>
            setTimeout(r, OUT_MS + HOLD_MS),
          );
          await Promise.all([original(), blank]);
        };
      });

      document.addEventListener("astro:before-swap", (e: any) => {
        const next: HTMLElement = e.newDocument.body;
        // The landing page owns its own reveal (preloader). Everything else fades up.
        if (!reduceMotion() && !next.classList.contains("pre")) {
          next.classList.add("fx-in");
        }
      });

      document.addEventListener("astro:page-load", () => {
        const b = document.body;
        if (b.classList.contains("fx-in")) {
          setTimeout(() => b.classList.remove("fx-in"), 1000);
        }
      });

      function InitSiteExperience() {
        const ring = document.querySelector<HTMLElement>(".custom-cursor");
        const pointer = document.querySelector<HTMLElement>(
          ".custom-cursor--pointer",
        );

        if (ring && pointer && window.matchMedia("(pointer: fine)").matches) {
          document.body.classList.add("has-custom-cursor");
          const activeRing = ring;
          const activePointer = pointer;

          let mouseX = -100;
          let mouseY = -100;
          let ringX = -100;
          let ringY = -100;
          let prevMouseX = -100;
          let prevMouseY = -100;
          let isOverIframe = false;

          const hideCursor = () => {
            activeRing.classList.remove("custom-cursor--visible");
            activePointer.classList.remove("custom-cursor--visible");
          };

          const showCursor = () => {
            if (!isOverIframe) {
              activeRing.classList.add("custom-cursor--visible");
              activePointer.classList.add("custom-cursor--visible");
            }
          };

          window.addEventListener("mousemove", (e: MouseEvent) => {
            if (isOverIframe) return;
            mouseX = e.clientX;
            mouseY = e.clientY;
            showCursor();
          });

          function AnimateCursor() {
            if (!isOverIframe) {
              const vx = mouseX - ringX;
              const vy = mouseY - ringY;
              ringX += vx * 0.22;
              ringY += vy * 0.22;

              const mouseVx = mouseX - prevMouseX;
              const mouseVy = mouseY - prevMouseY;
              const speed = Math.hypot(mouseVx, mouseVy);
              const angle = Math.atan2(mouseVy, mouseVx) * (180 / Math.PI);

              prevMouseX = mouseX;
              prevMouseY = mouseY;

              const blurAmount = Math.min(speed * 0.12, 3.5);
              const stretch = Math.min(speed * 0.015, 0.45);
              const squeeze = Math.min(speed * 0.008, 0.25);

              activeRing.style.left = `${ringX}px`;
              activeRing.style.top = `${ringY}px`;
              activeRing.style.filter =
                blurAmount > 0.3 ? `blur(${blurAmount * 0.8}px)` : "none";

              if (speed > 2.5) {
                activeRing.style.transform = `translate(-50%, -50%) rotate(${angle}deg) scale(${1 + stretch}, ${1 - squeeze})`;
              } else {
                activeRing.style.transform = `translate(-50%, -50%) scale(1)`;
              }

              activePointer.style.left = `${mouseX}px`;
              activePointer.style.top = `${mouseY}px`;
              activePointer.style.filter =
                blurAmount > 0.4 ? `blur(${blurAmount * 0.4}px)` : "none";
            }
            requestAnimationFrame(AnimateCursor);
          }
          requestAnimationFrame(AnimateCursor);

          const interactiveSelector =
            "a, button, [role='button'], input, textarea, select, label";
          document.querySelectorAll(interactiveSelector).forEach((el) => {
            el.addEventListener("mouseenter", () =>
              activeRing.classList.add("custom-cursor--hover"),
            );
            el.addEventListener("mouseleave", () =>
              activeRing.classList.remove("custom-cursor--hover"),
            );
          });

          const mediaZones = document.querySelectorAll<HTMLElement>(
            "iframe, video, .pj-video",
          );
          mediaZones.forEach((zone) => {
            zone.addEventListener("mouseenter", () => {
              isOverIframe = true;
              hideCursor();
            });
            zone.addEventListener("mouseleave", () => {
              isOverIframe = false;
              showCursor();
            });
          });

          document.addEventListener("mouseleave", hideCursor);
          window.addEventListener("blur", () => {
            isOverIframe = true;
            hideCursor();
          });
          window.addEventListener("focus", () => {
            isOverIframe = false;
          });
        }
      }

      InitSiteExperience();
      document.addEventListener("astro:page-load", InitSiteExperience);
    </script>
  </body>
</html>

<style>
  #page {
    transform: translateY(var(--menuH, 0px));
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
    min-height: 100vh;
  }
</style>
